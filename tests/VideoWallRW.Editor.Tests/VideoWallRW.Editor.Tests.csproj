<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testes da lógica do editor de imagem (sem tela): compila os arquivos do editor
       direto do App, então rodam também fora do Windows. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\VideoWallRW.App\AppPaths.cs" Link="Editor\AppPaths.cs" />
    <Compile Include="..\..\src\VideoWallRW.App\ViewModels\EditorLayer.cs" Link="Editor\EditorLayer.cs" />
    <Compile Include="..\..\src\VideoWallRW.App\ViewModels\ImageEditorViewModel.cs" Link="Editor\ImageEditorViewModel.cs" />
    <Compile Include="..\..\src\VideoWallRW.App\ViewModels\ImageEditorViewModel.Selection.cs" Link="Editor\ImageEditorViewModel.Selection.cs" />
    <Compile Include="..\..\src\VideoWallRW.App\ViewModels\SelectionGeometry.cs" Link="Editor\SelectionGeometry.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
