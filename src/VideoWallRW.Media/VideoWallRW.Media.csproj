<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows: WASAPI (NAudio.CoreAudioApi) e as DLLs do FFmpeg baixadas são Windows-only. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoWallRW.Core\VideoWallRW.Core.csproj" />
    <ProjectReference Include="..\VideoWallRW.Engine\VideoWallRW.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="7.1.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

  <!-- Copia as DLLs nativas do FFmpeg (shared build) para o diretório de saída.
       Coloque os binários em third_party/ffmpeg/ na raiz da solução. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\third_party\ffmpeg\*.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\..\third_party\ffmpeg\')" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Runtime do NDI embutido: a DLL vai junto do app pra receber NDI SEM instalar o
       NDI Tools/Runtime na máquina. NdiInterop procura ela ao lado do exe primeiro
       (ver NativeLibrary.SetDllImportResolver). A licença exige distribuir o texto
       Processing.NDI.Lib.Licenses.txt junto — por isso ele também é copiado. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\third_party\ndi\Processing.NDI.Lib.x64.dll" Condition="Exists('$(MSBuildThisFileDirectory)..\..\third_party\ndi\Processing.NDI.Lib.x64.dll')" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="$(MSBuildThisFileDirectory)..\..\third_party\ndi\Processing.NDI.Lib.Licenses.txt" Condition="Exists('$(MSBuildThisFileDirectory)..\..\third_party\ndi\Processing.NDI.Lib.Licenses.txt')" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
