<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoWallRW.Core\VideoWallRW.Core.csproj" />
    <ProjectReference Include="..\VideoWallRW.Engine\VideoWallRW.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="7.1.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <!-- Copia as DLLs nativas do FFmpeg (shared build) para o diretório de saída.
       Coloque os binários em third_party/ffmpeg/ na raiz da solução. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\third_party\ffmpeg\*.dll"
             Condition="Exists('$(MSBuildThisFileDirectory)..\..\third_party\ffmpeg\')"
             CopyToOutputDirectory="PreserveNewest"
             Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
