<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoWallRW.Core\VideoWallRW.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>

  <!-- Copiar shaders HLSL para o subdiretório correto no output -->
  <ItemGroup>
    <Content Include="Rendering\Shaders\*.hlsl"
             CopyToOutputDirectory="PreserveNewest"
             Link="Rendering\Shaders\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
