<Window x:Class="VideoWallRW.App.CellPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher célula de destino" Height="180" Width="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <DockPanel Background="{StaticResource Bg}" Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Usar célula" Style="{StaticResource PrimaryAction}" IsDefault="True" Click="OnOk" Padding="16,4" Margin="0,0,6,0" />
      <Button Content="Cancelar" IsCancel="True" Padding="10,4" />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Camada" VerticalAlignment="Center" Margin="0,0,10,8" />
      <ComboBox x:Name="LayerPicker" Grid.Column="1" Margin="0,0,0,8" />
      <TextBlock Grid.Row="1" Text="Coluna" VerticalAlignment="Center" Margin="0,0,10,0" />
      <ComboBox x:Name="ColumnPicker" Grid.Row="1" Grid.Column="1" />
    </Grid>
  </DockPanel>
</Window>
