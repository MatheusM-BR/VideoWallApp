<Window x:Class="VideoWallRW.App.AgendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imagens do site — Agenda de leilões" Height="780" Width="1180" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/Auxiliary.xaml" />
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="8" Background="{StaticResource Bg}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Style="{StaticResource SurfacePanel}" Margin="0,0,0,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding Downloading, Converter={StaticResource InverseBoolConverter}}">
          <Button AutomationProperties.Name="Dia anterior" Content="‹" Command="{Binding PreviousDayCommand}" Width="30" Padding="0,6" ToolTip="Dia anterior" />
          <TextBlock Text="{Binding Date, StringFormat=dd/MM/yyyy}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
          <Button AutomationProperties.Name="Próximo dia" Content="›" Command="{Binding NextDayCommand}" Width="30" Padding="0,6" ToolTip="Próximo dia" />
          <Button Content="Hoje" Command="{Binding TodayCommand}" Padding="12,6" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel><TextBlock Text="Imagens do site" Style="{StaticResource PageTitle}" /><TextBlock Text="Escolha um leilão, confira o banner e abra no editor." Foreground="{StaticResource FgDim}" Margin="0,4,12,0" /></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" x:Name="AgendaWorkspace">
      <Grid.ColumnDefinitions><ColumnDefinition Width="0.43*" MinWidth="260" MaxWidth="420" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" MinWidth="540" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource SurfacePanel}" Padding="10">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="2,2,2,12"><TextBlock DockPanel.Dock="Right" Text="{Binding Events.Count, StringFormat={}{0} eventos}" FontSize="11" Foreground="{StaticResource FgDim}" /><TextBlock Text="LEILÕES DO DIA" Style="{StaticResource SectionTitle}" /></DockPanel>
          <ProgressBar DockPanel.Dock="Top" Height="3" IsIndeterminate="True" Margin="0,0,0,8" Foreground="{StaticResource Selection}" Visibility="{Binding Loading, Converter={StaticResource BoolToVisibilityConverter}}" />
          <Grid>
            <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding Downloading, Converter={StaticResource InverseBoolConverter}}">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,10"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Nenhum evento listado. Consulte outra data ou confira a mensagem abaixo." TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource FgDim}" Margin="16">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Events.Count}" Value="0" /><Condition Binding="{Binding Loading}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Style="{StaticResource WorkspaceSplitter}" AutomationProperties.Name="Largura da lista de leilões" />
      <Border Grid.Column="2" Style="{StaticResource SurfacePanel}" Padding="14">
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Visibility="{Binding SelectedEvent, Converter={StaticResource NullToVisibilityConverter}}"><TextBlock Text="Comece pela agenda" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,10" /><TextBlock Text="Selecione um leilão ao lado para visualizar a imagem e os documentos disponíveis no site." Foreground="{StaticResource FgDim}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding LoadingDetails, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="Buscando imagem e documentos…" Foreground="{StaticResource FgDim}" Margin="0,0,0,12" /><ProgressBar IsIndeterminate="True" Height="4" Width="260" /></StackPanel>
          <Grid DataContext="{Binding Details}" Visibility="{Binding Converter={StaticResource NotNullToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="140" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12"><TextBlock Text="PRÉVIA DO BANNER" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" /><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="75" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /></StackPanel>
            <Border Grid.Row="1" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Padding="12" ClipToBounds="True">
              <Grid>
                <Image Source="{Binding DataContext.BannerPreviewPath, RelativeSource={RelativeSource AncestorType=Window}}"
                       Stretch="Uniform" />
                <TextBlock Text="Este evento não disponibilizou um banner." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource FgDim}" Visibility="{Binding BannerUrl, Converter={StaticResource NullToVisibilityConverter}}" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,12,0,12">
              <WrapPanel><Button Content="Salvar e abrir no editor" Style="{StaticResource PrimaryAction}" Margin="0,0,8,6" Command="{Binding DataContext.SaveBannerAndEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" /><Button Content="Salvar banner" Padding="14,8" Margin="0,0,0,6" Command="{Binding DataContext.SaveBannerCommand, RelativeSource={RelativeSource AncestorType=Window}}" /></WrapPanel>
              <TextBlock Text="O arquivo salvo fica disponível na biblioteca da janela principal." Foreground="{StaticResource FgDim}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Expander Grid.Row="3" Header="Documentos do evento" Foreground="{StaticResource Fg}" IsExpanded="False">
              <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding Downloads}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource FgDim}" Margin="0,0,0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <WrapPanel><Button Content="Catálogo PDF" Padding="12,7" Margin="0,4,8,0" Command="{Binding DataContext.DownloadCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}" /><Button Content="Regulamento PDF" Padding="12,7" Margin="0,4,0,0" Command="{Binding DataContext.DownloadRegulationCommand, RelativeSource={RelativeSource AncestorType=Window}}" /></WrapPanel>
              </StackPanel></ScrollViewer>
            </Expander>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource SurfacePanel}" Padding="10,8" Margin="0,6,0,0"><StackPanel>
      <ProgressBar Height="4" Margin="0,0,0,8" Minimum="0" Maximum="1" Value="{Binding DownloadProgress, Mode=OneWay}" Visibility="{Binding Downloading, Converter={StaticResource BoolToVisibilityConverter}}" />
      <TextBlock Text="Baixando arquivo…" Foreground="{StaticResource Selection}" Margin="0,0,0,4" Visibility="{Binding Downloading, Converter={StaticResource BoolToVisibilityConverter}}" />
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" Foreground="{StaticResource FgDim}" />
    </StackPanel></Border>
  </Grid>
</Window>
