<Window x:Class="VideoWallRW.App.AgendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agenda de Leilões" Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button DockPanel.Dock="Left" Content="◀" Command="{Binding PreviousDayCommand}" Padding="8,4" Margin="0,0,4,0" />
      <Button DockPanel.Dock="Left" Content="Hoje" Command="{Binding TodayCommand}" Padding="8,4" Margin="0,0,4,0" />
      <Button DockPanel.Dock="Left" Content="▶" Command="{Binding NextDayCommand}" Padding="8,4" Margin="0,0,10,0" />
      <TextBlock DockPanel.Dock="Left" Text="{Binding Date, StringFormat=dd/MM/yyyy}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
      <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" Margin="0,0,10,0">
        <TextBlock DockPanel.Dock="Top" Text="Leilões do dia" FontWeight="Bold" Margin="0,0,0,6" />
        <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Column="1" DataContext="{Binding Details}">
        <TextBlock DockPanel.Dock="Top" Text="Selecione um leilão à esquerda." Foreground="{StaticResource FgDim}"
                   Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}" />
        <StackPanel Visibility="{Binding Converter={StaticResource NotNullToVisibilityConverter}}">
          <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" TextWrapping="Wrap" />
          <Image Source="{Binding BannerPreviewUrl}" MaxHeight="300" HorizontalAlignment="Left" Margin="0,0,0,10"
                 Visibility="{Binding BannerUrl, Converter={StaticResource NotNullToVisibilityConverter}}" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Salvar banner" Padding="10,4" Margin="0,0,6,0"
                    Command="{Binding DataContext.SaveBannerCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Salvar banner e editar" Padding="10,4" Margin="0,0,6,0"
                    Command="{Binding DataContext.SaveBannerAndEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Salvar e enviar p/ célula" Padding="10,4"
                    Command="{Binding DataContext.SaveBannerAndSendCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Downloads}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Width="220" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Catálogo PDF..." Padding="10,4" Margin="0,0,6,0"
                    Command="{Binding DataContext.DownloadCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="Regulamento PDF..." Padding="10,4"
                    Command="{Binding DataContext.DownloadRegulationCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          </StackPanel>

          <ProgressBar Height="6" Margin="0,10,0,0" Minimum="0" Maximum="1"
                       Value="{Binding DataContext.DownloadProgress, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                       Visibility="{Binding DataContext.Downloading, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
