<Window x:Class="VideoWallRW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="800" Width="960"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown">
  <DockPanel Margin="12">

    <!-- Barra de projeto -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Left" Content="Novo" Command="{Binding NewProjectCommand}" Padding="8,4" Margin="0,0,4,0" />
      <Button DockPanel.Dock="Left" Content="Abrir..." Command="{Binding OpenProjectCommand}" Padding="8,4" Margin="0,0,4,0" />
      <Button DockPanel.Dock="Left" Content="Salvar" Command="{Binding SaveProjectCommand}" Padding="8,4" Margin="0,0,4,0" />
      <Button DockPanel.Dock="Left" Content="Salvar como..." Command="{Binding SaveProjectAsCommand}" Padding="8,4" Margin="0,0,14,0" />
      <Button DockPanel.Dock="Left" Content="⌨ Atalhos..." Command="{Binding OpenKeymapEditorCommand}" Padding="8,4" Margin="0,0,4,0" />
      <Button DockPanel.Dock="Left" Content="⚙ Instalação..." Command="{Binding OpenInstallationCommand}" Padding="8,4" Margin="0,0,4,0" />
      <ToggleButton DockPanel.Dock="Left" Content="▶ Sequenciador" IsChecked="{Binding SequencerRunning}"
                    Padding="8,4" Margin="0,0,4,0" />
      <ToggleButton DockPanel.Dock="Right" Content="BLACKOUT" IsChecked="{Binding Blackout}" Padding="10,4" Margin="10,0,0,0"
                    Background="#CC0000" Foreground="White" FontWeight="Bold" />
      <TextBlock DockPanel.Dock="Right" Text="Master:" VerticalAlignment="Center" Margin="10,0,4,0" />
      <Slider DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="1" Value="{Binding MasterFader}" VerticalAlignment="Center" />
    </DockPanel>

    <!-- Cenas (T7.5) -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Left" Content="+ Salvar cena" Command="{Binding SaveSceneCommand}" Padding="8,4" Margin="0,0,10,0" />
      <ItemsControl ItemsSource="{Binding Scenes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#CCC" BorderThickness="1" Margin="0,0,6,0" Padding="4">
              <StackPanel Orientation="Horizontal">
                <Button Content="{Binding Name}" Command="{Binding TriggerCommand}" Padding="6,2" />
                <Button Content="✕" Command="{Binding RemoveCommand}" Padding="4,2" Margin="4,0,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>

    <!-- Título da seção de monitores -->
    <TextBlock DockPanel.Dock="Top" Text="Monitores detectados"
               FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

    <!-- Grade de Composição (Fase 2) -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
      <StackPanel>
        <DockPanel Margin="0,0,0,6">
          <Button DockPanel.Dock="Left" Content="📂 Load Slot [L0, C0]" Command="{Binding OpenVideoCommand}" Padding="10,4" Margin="0,0,6,0" />
          <Button DockPanel.Dock="Left" Content="+ Layer" Command="{Binding Grid.AddLayerCommand}" Padding="10,4" Margin="0,0,6,0" />
          <Button DockPanel.Dock="Left" Content="+ Coluna" Command="{Binding Grid.AddColumnCommand}" Padding="10,4" Margin="0,0,6,0" />
          <Button DockPanel.Dock="Left" Content="🖥 Advanced Output..." Command="{Binding OpenOutputSetupCommand}" Padding="10,4" Margin="0,0,6,0" />
          <Button DockPanel.Dock="Left" Content="⚡ Converter para HAP..." Command="{Binding OpenHapConverterCommand}" Padding="10,4" Margin="0,0,6,0" />
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#555" />
        </DockPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="350">
          <ItemsControl ItemsSource="{Binding Grid.Layers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,8" Background="#FAFAFA" LastChildFill="True">
                  <!-- Painel Lateral da Camada -->
                  <StackPanel DockPanel.Dock="Left" Width="150" Margin="6" Background="#F0F0F0">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="4,4,0,2"/>
                    <Button Content="Limpar Layer" Command="{Binding ClearCommand}" Margin="4" Padding="2" />
                    <TextBlock Text="Opacity" FontSize="10" Margin="4,2,0,0" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" Margin="4,0,4,4" />
                    <ComboBox ItemsSource="{Binding DataContext.Grid.BlendModes, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding Blend, Mode=TwoWay}" Margin="4,0,4,4" />
                    <TextBlock Text="Transição (s)" FontSize="10" Margin="4,0,0,0" />
                    <Slider Minimum="0" Maximum="5" Value="{Binding TransitionSeconds, Mode=TwoWay}"
                            Margin="4,0,4,4" />
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,4">
                      <CheckBox Content="Bypass" IsChecked="{Binding Bypass, Mode=TwoWay}" FontSize="10" />
                      <CheckBox Content="Solo" IsChecked="{Binding Solo, Mode=TwoWay}" FontSize="10" Margin="6,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                  <!-- Grade de Clipes -->
                  <ItemsControl ItemsSource="{Binding Clips}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" Width="100" Height="75" Margin="4" AllowDrop="True" Drop="OnClipDrop">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="#E0E0E0"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMedia}" Value="True">
                                  <Setter Property="Background" Value="#A0D8A0"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Button Command="{Binding TriggerCommand}" Background="Transparent" BorderThickness="0">
                            <TextBlock Text="{Binding Name}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Padding="4"/>
                          </Button>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Propriedades do clip selecionado. Clique em um slot para selecionar e disparar. -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0"
            Padding="0,10,0,0" Margin="0,10,0,0" DataContext="{Binding Grid.SelectedClip}">
      <Grid IsEnabled="{Binding HasMedia}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="6" Text="Propriedades do clip selecionado" FontWeight="Bold" Margin="0,0,0,6" />

        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Nome" Margin="0,0,6,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Modo" Margin="0,0,6,0" />
        <ComboBox Grid.Row="1" Grid.Column="3"
                  ItemsSource="{Binding DataContext.Grid.PlayModes, RelativeSource={RelativeSource AncestorType=Window}}"
                  SelectedItem="{Binding PlayMode, Mode=TwoWay}" Margin="0,0,12,0" />
        <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Text="Autopilot" Margin="0,0,6,0" />
        <ComboBox Grid.Row="1" Grid.Column="5"
                  ItemsSource="{Binding DataContext.Grid.AutopilotActions, RelativeSource={RelativeSource AncestorType=Window}}"
                  SelectedItem="{Binding Autopilot, Mode=TwoWay}" />

        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Velocidade" Margin="0,8,6,0" />
        <Slider Grid.Row="2" Grid.Column="1" Minimum="0.1" Maximum="4" Value="{Binding Speed, Mode=TwoWay}"
                Margin="0,8,12,0" />
        <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                   Text="{Binding Speed, StringFormat={}{0:F1}×}" Margin="0,8,0,0" />

        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="In / Out (s)" Margin="0,8,6,0" />
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,12,0">
          <TextBox Width="72" Text="{Binding InPointText, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Text=" / " VerticalAlignment="Center" />
          <TextBox Width="72" Text="{Binding OutPointText, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>
        <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Text="Duração imagem" Margin="0,8,6,0" />
        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding ImageDurationText, UpdateSourceTrigger=LostFocus}" Margin="0,8,12,0" />
        <TextBlock Grid.Row="3" Grid.Column="4" VerticalAlignment="Center" Text="Resize" Margin="0,8,6,0" />
        <ComboBox Grid.Row="3" Grid.Column="5"
                  ItemsSource="{Binding DataContext.Grid.ResizeModes, RelativeSource={RelativeSource AncestorType=Window}}"
                  SelectedItem="{Binding Resize, Mode=TwoWay}" Margin="0,8,0,0" />

        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Volume" Margin="0,8,6,0" />
        <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                Margin="0,8,12,0" />
        <CheckBox Grid.Row="4" Grid.Column="2" Content="Mute" IsChecked="{Binding Mute, Mode=TwoWay}"
                  Margin="0,8,0,0" />
      </Grid>
    </Border>

    <!-- Botão atualizar monitores -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
      <Button DockPanel.Dock="Left" Content="Atualizar monitores"
              Command="{Binding RefreshMonitorsCommand}" Padding="12,4" />
    </DockPanel>

    <!-- Lista de monitores -->
    <ListBox ItemsSource="{Binding Monitors}" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding FpsText}"
                       Foreground="Green" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
            <CheckBox IsChecked="{Binding IsActive}" Content="{Binding Title}"
                      VerticalAlignment="Center" />
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Window>
