<Window x:Class="VideoWallRW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoWallRW — Fase 0 (Fundação)" Height="420" Width="680"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Text="Monitores detectados"
               FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Button DockPanel.Dock="Left" Content="Atualizar monitores"
              Command="{Binding RefreshMonitorsCommand}" Padding="12,4" />
      <TextBlock Text="{Binding StatusText}" Margin="16,4,0,0"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </DockPanel>
    <ListBox ItemsSource="{Binding Monitors}" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding FpsText}"
                       Foreground="Green" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
            <CheckBox IsChecked="{Binding IsActive}" Content="{Binding Title}"
                      VerticalAlignment="Center" />
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
