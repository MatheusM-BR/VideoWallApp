<Window x:Class="VideoWallRW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoWallRW.App.Controls"
        Title="{Binding WindowTitle}" Height="860" Width="1180"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <DockPanel Margin="8">

    <!-- ═══ Barra superior: projeto + ferramentas + master (estilo Resolume: tudo numa régua) ═══ -->
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDim}"
            BorderThickness="1" Padding="6" Margin="0,0,0,6">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="Novo" Command="{Binding NewProjectCommand}" Margin="0,0,3,0" />
        <Button DockPanel.Dock="Left" Content="Abrir" Command="{Binding OpenProjectCommand}" Margin="0,0,3,0" />
        <Button DockPanel.Dock="Left" Content="Salvar" Command="{Binding SaveProjectCommand}" Margin="0,0,3,0" />
        <Button DockPanel.Dock="Left" Content="Salvar como" Command="{Binding SaveProjectAsCommand}" Margin="0,0,12,0" />

        <Button DockPanel.Dock="Left" Content="🖥 Output" Command="{Binding OpenOutputSetupCommand}" Margin="0,0,3,0" />
        <Button DockPanel.Dock="Left" Content="⚙ Instalação" Command="{Binding OpenInstallationCommand}" Margin="0,0,3,0" />
        <Button DockPanel.Dock="Left" Content="🗓 Agenda" Command="{Binding OpenAgendaCommand}" Margin="0,0,3,0" />
        <Button DockPanel.Dock="Left" Content="⚡ HAP" Command="{Binding OpenHapConverterCommand}" Margin="0,0,3,0" />
        <Button DockPanel.Dock="Left" Content="⌨ Atalhos" Command="{Binding OpenKeymapEditorCommand}" Margin="0,0,12,0" />

        <ToggleButton DockPanel.Dock="Left" Content="▶ SEQ" IsChecked="{Binding SequencerRunning}"
                      ToolTip="Sequenciador de colunas (Instalação)" Margin="0,0,3,0" />

        <ToggleButton DockPanel.Dock="Right" Content="BLACKOUT" IsChecked="{Binding Blackout}"
                      Style="{StaticResource BlackoutButton}" Padding="14,4" Margin="10,0,0,0" />
        <Slider DockPanel.Dock="Right" Width="140" Minimum="0" Maximum="1" Value="{Binding MasterFader}"
                VerticalAlignment="Center" ToolTip="Master fader" />
        <TextBlock DockPanel.Dock="Right" Text="MASTER" Foreground="{StaticResource FgDim}" FontSize="10"
                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
        <Border />
      </DockPanel>
    </Border>

    <!-- ═══ Cenas ═══ -->
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDim}"
            BorderThickness="1" Padding="6" Margin="0,0,0,6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="CENAS" Foreground="{StaticResource FgDim}" FontSize="10"
                   FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,8,0" />
        <Button DockPanel.Dock="Left" Content="+ Salvar cena" Command="{Binding SaveSceneCommand}" Margin="0,0,8,0" />
        <ItemsControl ItemsSource="{Binding Scenes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                <Button Content="{Binding Name}" Command="{Binding TriggerCommand}" />
                <Button Content="✕" Command="{Binding RemoveCommand}" Padding="4,3" Foreground="{StaticResource FgDim}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- ═══ Barra de status (rodapé) ═══ -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDim}"
            BorderThickness="1" Padding="6,3" Margin="0,6,0,0">
      <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource FgDim}"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- ═══ Saídas (monitores) — régua compacta no rodapé ═══ -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDim}"
            BorderThickness="1" Padding="6" Margin="0,6,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="SAÍDAS" Foreground="{StaticResource FgDim}" FontSize="10"
                   FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,8,0" />
        <Button DockPanel.Dock="Left" Content="↻" Command="{Binding RefreshMonitorsCommand}"
                ToolTip="Atualizar monitores" Margin="0,0,8,0" />
        <ItemsControl ItemsSource="{Binding Monitors}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource CellBg}" BorderBrush="{StaticResource BorderDim}"
                      BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal">
                  <CheckBox IsChecked="{Binding IsActive}" Content="{Binding Title}" FontSize="11" />
                  <TextBlock Text="{Binding FpsText}" Foreground="{StaticResource Accent}" FontSize="11"
                             FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- ═══ Propriedades do clip selecionado (faixa inferior, estilo painel de clip do Resolume) ═══ -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDim}"
            BorderThickness="1" Padding="8" Margin="0,6,0,0" DataContext="{Binding Grid.SelectedClip}">
      <Grid IsEnabled="{Binding HasMedia}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="7" Text="CLIP" Foreground="{StaticResource FgDim}" FontSize="10"
                   FontWeight="Bold" Margin="0,0,0,6" />

        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Nome" Margin="0,0,6,4" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,4" />
        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Modo" Margin="0,0,6,4" />
        <ComboBox Grid.Row="1" Grid.Column="3"
                  ItemsSource="{Binding DataContext.Grid.PlayModes, RelativeSource={RelativeSource AncestorType=Window}}"
                  SelectedItem="{Binding PlayMode, Mode=TwoWay}" Margin="0,0,12,4" />
        <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Text="Autopilot" Margin="0,0,6,4" />
        <ComboBox Grid.Row="1" Grid.Column="5"
                  ItemsSource="{Binding DataContext.Grid.AutopilotActions, RelativeSource={RelativeSource AncestorType=Window}}"
                  SelectedItem="{Binding Autopilot, Mode=TwoWay}" Margin="0,0,0,4" />
        <StackPanel Grid.Row="1" Grid.Column="6" Orientation="Horizontal" Margin="12,0,0,4">
          <TextBlock Text="Velocidade" VerticalAlignment="Center" Margin="0,0,6,0" />
          <Slider Width="110" Minimum="0.1" Maximum="4" Value="{Binding Speed, Mode=TwoWay}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Speed, StringFormat={}{0:F1}×}" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="In / Out (s)" Margin="0,0,6,0" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
          <TextBox Width="70" Text="{Binding InPointText, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Text=" / " VerticalAlignment="Center" />
          <TextBox Width="70" Text="{Binding OutPointText, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>
        <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="Dur. imagem" Margin="0,0,6,0" />
        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ImageDurationText, UpdateSourceTrigger=LostFocus}" Margin="0,0,12,0" />
        <TextBlock Grid.Row="2" Grid.Column="4" VerticalAlignment="Center" Text="Resize" Margin="0,0,6,0" />
        <ComboBox Grid.Row="2" Grid.Column="5"
                  ItemsSource="{Binding DataContext.Grid.ResizeModes, RelativeSource={RelativeSource AncestorType=Window}}"
                  SelectedItem="{Binding Resize, Mode=TwoWay}" />
        <StackPanel Grid.Row="2" Grid.Column="6" Orientation="Horizontal" Margin="12,0,0,0">
          <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,6,0" />
          <Slider Width="110" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
          <CheckBox Content="Mute" IsChecked="{Binding Mute, Mode=TwoWay}" Margin="10,0,0,0" />
        </StackPanel>

        <!-- Trim estilo Resolume: barra da duração inteira, alças arrastáveis de In/Out -->
        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Trim" Margin="0,8,6,0" />
        <controls:TrimBar Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="6" Height="26" Margin="0,8,0,0"
                          Duration="{Binding Duration}"
                          InPoint="{Binding TrimIn, Mode=TwoWay}"
                          OutPoint="{Binding TrimOut, Mode=TwoWay}" />
      </Grid>
    </Border>

    <!-- ═══ Área central: grade (esq.) + dock Files/Preview (dir.), como no Resolume ═══ -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="250" />
      </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDim}"
            BorderThickness="1" Padding="6">
      <DockPanel>
        <!-- Mini-toolbar da composição -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
          <Button Content="📂 Carregar mídia" Command="{Binding OpenVideoCommand}" Margin="0,0,3,0" />
          <Button Content="+ Layer" Command="{Binding Grid.AddLayerCommand}" Margin="0,0,3,0" />
          <Button Content="+ Coluna" Command="{Binding Grid.AddColumnCommand}" Margin="0,0,3,0" />
          <TextBlock Text="  arraste arquivos para as células" Foreground="{StaticResource FgDim}"
                     FontSize="11" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <StackPanel>

            <!-- Cabeçalho de colunas: botões que disparam a coluna inteira (Resolume) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Border Width="154" />
              <ItemsControl ItemsSource="{Binding Grid.Columns}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="104" Margin="2,0" Padding="0,4" FontWeight="Bold"
                            Content="{Binding Converter={StaticResource IncrementConverter}}"
                            Command="{Binding DataContext.Grid.TriggerColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Disparar coluna inteira" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Layers -->
            <ItemsControl ItemsSource="{Binding Grid.Layers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,4">

                    <!-- Painel da layer (nome, X, B/S, blend, V, transição) -->
                    <Border DockPanel.Dock="Left" Width="150" Margin="2,0" Background="{StaticResource CellBg}"
                            BorderBrush="{StaticResource BorderDim}" BorderThickness="1" CornerRadius="2" Padding="5">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                          <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClearCommand}"
                                  Padding="5,1" FontSize="10" ToolTip="Limpar layer (tirar do ar)" />
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <ToggleButton Content="B" IsChecked="{Binding Bypass}" Padding="7,1" FontSize="10"
                                        ToolTip="Bypass" Margin="0,0,3,0" />
                          <ToggleButton Content="S" IsChecked="{Binding Solo}" Padding="7,1" FontSize="10"
                                        ToolTip="Solo" Margin="0,0,3,0" />
                          <ComboBox Width="86" FontSize="10"
                                    ItemsSource="{Binding DataContext.Grid.BlendModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                    SelectedItem="{Binding Blend, Mode=TwoWay}" />
                        </StackPanel>
                        <DockPanel Margin="0,0,0,2">
                          <TextBlock DockPanel.Dock="Left" Text="V" FontSize="10" Width="12"
                                     Foreground="{StaticResource FgDim}" VerticalAlignment="Center" />
                          <Slider Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" ToolTip="Opacidade" />
                        </DockPanel>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Left" Text="T" FontSize="10" Width="12"
                                     Foreground="{StaticResource FgDim}" VerticalAlignment="Center" />
                          <Slider Minimum="0" Maximum="5" Value="{Binding TransitionSeconds, Mode=TwoWay}"
                                  ToolTip="Transição (s)" />
                        </DockPanel>
                      </StackPanel>
                    </Border>

                    <!-- Células de clip -->
                    <ItemsControl ItemsSource="{Binding Clips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Width="104" Height="86" Margin="2,0" CornerRadius="2"
                                  AllowDrop="True" Drop="OnClipDrop">
                            <Border.ContextMenu>
                              <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Editar imagem..." Click="OnEditImageClick" />
                              </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource InputBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderDim}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasMedia}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CellMediaBg}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentDim}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <DockPanel>
                              <!-- Barra de nome (embaixo): clique SELECIONA o clip sem colocar no ar -->
                              <Button DockPanel.Dock="Bottom" Height="19" Command="{Binding SelectCommand}"
                                      AllowDrop="True" Padding="3,0" BorderThickness="0,1,0,0"
                                      ToolTip="Selecionar para edição (não coloca no ar)">
                                <Button.Style>
                                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="{StaticResource InputBg}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentDim}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                      <Setter Property="Foreground" Value="{StaticResource FgDim}" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedia}" Value="True">
                                          <Setter Property="Foreground" Value="{StaticResource Fg}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </Button>
                              <!-- Preview (em cima): clique COLOCA NO AR -->
                              <Button Command="{Binding TriggerCommand}" AllowDrop="True"
                                      Background="Transparent" BorderThickness="0" Padding="0"
                                      ToolTip="Disparar (colocar no ar)">
                                <Grid ClipToBounds="True">
                                  <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                </Grid>
                              </Button>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ═══ Dock direito: FILES (navegador de pastas) + PREVIEW do clip selecionado ═══ -->
    <DockPanel Grid.Column="1" Margin="6,0,0,0">

      <!-- PREVIEW (embaixo) -->
      <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDim}"
              BorderThickness="1" Padding="6" Margin="0,6,0,0" DataContext="{Binding Grid.SelectedClip}">
        <StackPanel>
          <TextBlock Text="PREVIEW" Foreground="{StaticResource FgDim}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
          <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1"
                  Height="128" ClipToBounds="True">
            <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" />
          </Border>
          <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock FontSize="10" Foreground="{StaticResource FgDim}">
            <Run Text="Duração: " /><Run Text="{Binding Duration, Mode=OneWay, StringFormat={}{0:F1}s}" />
            <Run Text="   In/Out: " /><Run Text="{Binding TrimIn, Mode=OneWay, StringFormat={}{0:F1}}" />
            <Run Text=" → " /><Run Text="{Binding TrimOut, Mode=OneWay, StringFormat={}{0:F1}}" />
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- FILES (preenche) -->
      <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1"
              Padding="6">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left" Text="FILES" Foreground="{StaticResource FgDim}" FontSize="10"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button DockPanel.Dock="Right" Content="↻" Command="{Binding FileBrowser.RefreshCommand}"
                    Padding="5,1" FontSize="10" ToolTip="Atualizar" />
            <Button DockPanel.Dock="Right" Content="⬆" Command="{Binding FileBrowser.NavigateUpCommand}"
                    Padding="5,1" FontSize="10" Margin="0,0,3,0" ToolTip="Pasta acima" />
            <Button DockPanel.Dock="Right" Content="📂" Command="{Binding FileBrowser.BrowseCommand}"
                    Padding="5,1" FontSize="10" Margin="0,0,3,0" ToolTip="Escolher pasta..." />
            <Border />
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding FileBrowser.CurrentFolder}" FontSize="9"
                     Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                     ToolTip="{Binding FileBrowser.CurrentFolder}" />
          <TextBlock DockPanel.Dock="Bottom" Text="duplo-clique envia p/ célula · arraste p/ grade" FontSize="9"
                     Foreground="{StaticResource FgDim}" Margin="0,4,0,0" />
          <ListBox x:Name="FileList" ItemsSource="{Binding FileBrowser.Items}"
                   MouseDoubleClick="OnFileListDoubleClick"
                   PreviewMouseLeftButtonDown="OnFileListMouseDown"
                   PreviewMouseMove="OnFileListMouseMove">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Icon}" FontSize="11" Margin="0,0,5,0" />
                  <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </DockPanel>
    </Grid>

  </DockPanel>
</Window>
