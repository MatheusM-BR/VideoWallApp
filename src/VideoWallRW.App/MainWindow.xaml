<Window x:Class="VideoWallRW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoWallRW — Fase 1 (Player)" Height="520" Width="720"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="12">

    <!-- Título da seção de monitores -->
    <TextBlock DockPanel.Dock="Top" Text="Monitores detectados"
               FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

    <!-- Controles de clip — ancorados no rodapé -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0"
            Padding="0,10,0,0" Margin="0,10,0,0">
      <StackPanel>

        <!-- Linha 1: abrir + play/pause + velocidade -->
        <DockPanel Margin="0,0,0,6">
          <Button DockPanel.Dock="Left" Content="📂 Abrir vídeo…"
                  Command="{Binding OpenVideoCommand}" Padding="10,4" Margin="0,0,6,0" />
          <Button DockPanel.Dock="Left" Content="{Binding PlayPauseLabel}"
                  Command="{Binding PlayPauseCommand}"
                  IsEnabled="{Binding ClipLoaded}" Padding="10,4" Margin="0,0,12,0" />
          <TextBlock DockPanel.Dock="Left" Text="Vel.:" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox DockPanel.Dock="Left" Width="70"
                    IsEnabled="{Binding ClipLoaded}"
                    SelectedValuePath="Tag"
                    SelectionChanged="OnSpeedChanged">
            <ComboBoxItem Content="0.25×" Tag="0.25"/>
            <ComboBoxItem Content="0.5×"  Tag="0.5"/>
            <ComboBoxItem Content="1×"    Tag="1.0" IsSelected="True"/>
            <ComboBoxItem Content="2×"    Tag="2.0"/>
            <ComboBoxItem Content="4×"    Tag="4.0"/>
          </ComboBox>
          <TextBlock Text="{Binding TimecodeText}" Margin="16,0,0,0"
                     VerticalAlignment="Center" FontFamily="Consolas" />
        </DockPanel>

        <!-- Linha 2: slider de seek -->
        <Slider Minimum="0" Maximum="{Binding SeekMax}"
                Value="{Binding SeekPosition, Mode=TwoWay}"
                IsEnabled="{Binding ClipLoaded}"
                IsMoveToPointEnabled="True"
                PreviewMouseUp="OnSeekMouseUp"
                Margin="0,0,0,6" />

        <!-- Status bar -->
        <TextBlock Text="{Binding StatusText}"
                   TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#555" />
      </StackPanel>
    </Border>

    <!-- Botão atualizar monitores -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
      <Button DockPanel.Dock="Left" Content="Atualizar monitores"
              Command="{Binding RefreshMonitorsCommand}" Padding="12,4" />
    </DockPanel>

    <!-- Lista de monitores -->
    <ListBox ItemsSource="{Binding Monitors}" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding FpsText}"
                       Foreground="Green" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
            <CheckBox IsChecked="{Binding IsActive}" Content="{Binding Title}"
                      VerticalAlignment="Center" />
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Window>
