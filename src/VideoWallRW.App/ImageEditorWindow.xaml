<Window x:Class="VideoWallRW.App.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:vm="clr-namespace:VideoWallRW.App.ViewModels"
        Title="Editor de imagem — VideoWallRW" Height="820" Width="1280" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" PreviewKeyDown="OnEditorKeyDown">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/Auxiliary.xaml" />
  </ResourceDictionary.MergedDictionaries>
    <Style x:Key="PaintToolChoice" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,4,4" /><Setter Property="Padding" Value="6,9" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Surface" Background="{StaticResource CellBg}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SelectionBg}" /><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Selection}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Ícones dos pincéis (24×24) — reconhecer a ferramenta pela figura, não só pelo nome. -->
    <Geometry x:Key="IconBrush">M20.7,3.3 C19.9,2.5 18.6,2.5 17.8,3.3 L9,12.1 L11.9,15 L20.7,6.2 C21.5,5.4 21.5,4.1 20.7,3.3 Z M7.5,13.5 C5.6,13.5 4,15.1 4,17 C4,18.3 2.9,19 2,19 C3,20.3 4.7,21 6.5,21 C8.9,21 11,18.9 11,16.5 C11,14.8 9.4,13.5 7.5,13.5 Z</Geometry>
    <Geometry x:Key="IconEraser">M16.2,3.6 L21.4,8.8 C22.2,9.6 22.2,10.8 21.4,11.6 L12.5,20.5 L20,20.5 L20,22 L8,22 L2.6,16.6 C1.8,15.8 1.8,14.6 2.6,13.8 L13.4,3.6 C14.2,2.8 15.4,2.8 16.2,3.6 Z M4,15.2 L8.8,20 L10.4,20 L13.5,16.9 L8.3,11.7 Z</Geometry>
    <Geometry x:Key="IconBucket">M16.6,8.9 L7.7,0 L6.3,1.4 L8.7,3.8 L3.5,9 C2.9,9.6 2.9,10.5 3.5,11.1 L9,16.6 C9.6,17.2 10.6,17.2 11.2,16.6 L16.6,11.2 C17.2,10.6 17.2,9.6 16.6,8.9 Z M5.2,10 L10.1,5.2 L15,10 Z M19,11.5 C19,11.5 17,13.7 17,15 C17,16.1 17.9,17 19,17 C20.1,17 21,16.1 21,15 C21,13.7 19,11.5 19,11.5 Z M2,20 L22,20 L22,24 L2,24 Z</Geometry>
    <Geometry x:Key="IconEyedropper">M20.7,5.6 L18.4,3.3 C18,2.9 17.4,2.9 17,3.3 L13.8,6.4 L11.9,4.5 L10.5,5.9 L11.9,7.3 L3,16.3 L3,21 L7.8,21 L16.7,12.1 L18.1,13.5 L19.5,12.1 L17.6,10.2 L20.7,7.1 C21.1,6.7 21.1,6 20.7,5.6 Z M6.9,19 L5,17.1 L13.1,9 L15,10.9 Z</Geometry>

    <!-- Aplicar tamanho: cinza parado; azul quando há tamanho pendente (Tag="pending"). -->
    <Style x:Key="ApplyCanvasStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource CellBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderDim}" />
      <Setter Property="Foreground" Value="{StaticResource FgDim}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="pending">
          <Setter Property="Background" Value="#FF1F6FD6" />
          <Setter Property="BorderBrush" Value="{StaticResource Selection}" />
          <Setter Property="Foreground" Value="White" />
          <Setter Property="FontWeight" Value="Bold" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Atalhos de pintura na barra superior (conta-gotas, balde) -->
    <Style x:Key="QuickTool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0,0,4,0" /><Setter Property="Padding" Value="0" />
    </Style>
  </ResourceDictionary></Window.Resources>
  <Grid Margin="8" Background="{StaticResource Bg}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
    <Border Style="{StaticResource SurfacePanel}" Padding="14,10" Margin="0,0,0,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Desfazer" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="0,0,4,0" Padding="10,6" />
          <Button Content="Refazer" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Margin="0,0,16,0" Padding="10,6" />
          <Button Content="Salvar imagem" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryAction}" />
        </StackPanel>
        <TextBlock Text="Editor de imagem" Style="{StaticResource PageTitle}" />
      </DockPanel>
    </Border>
    <!-- UX do Paint 3D: categorias no topo, área de desenho ao centro e opções à direita. -->
    <Border Grid.Row="1" Style="{StaticResource SurfacePanel}" Padding="8,2" Margin="0,0,0,6">
      <DockPanel>
      <!-- Acesso rápido: conta-gotas, balde e a cor atual, sem abrir a categoria Pincéis. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button AutomationProperties.Name="Conta-gotas" ToolTip="Conta-gotas: clique na imagem pra pegar uma cor" Tag="{x:Static vm:EditorTool.Eyedropper}" Click="OnQuickToolClick">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuickTool}"><Style.Triggers>
            <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Eyedropper}"><Setter Property="Background" Value="{StaticResource SelectionBg}" /><Setter Property="BorderBrush" Value="{StaticResource Selection}" /></DataTrigger>
          </Style.Triggers></Style></Button.Style>
          <Path Data="{StaticResource IconEyedropper}" Fill="{StaticResource Fg}" Width="20" Height="20" Stretch="Uniform" />
        </Button>
        <Button AutomationProperties.Name="Balde de tinta" ToolTip="Balde: preenche uma área com a cor atual" Tag="{x:Static vm:EditorTool.Bucket}" Click="OnQuickToolClick">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuickTool}"><Style.Triggers>
            <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Bucket}"><Setter Property="Background" Value="{StaticResource SelectionBg}" /><Setter Property="BorderBrush" Value="{StaticResource Selection}" /></DataTrigger>
          </Style.Triggers></Style></Button.Style>
          <Path Data="{StaticResource IconBucket}" Fill="{StaticResource Fg}" Width="20" Height="20" Stretch="Uniform" />
        </Button>
        <ToggleButton x:Name="ColorSwatchToggle" Width="44" Height="44" Padding="5" AutomationProperties.Name="Cor selecionada" ToolTip="Cor selecionada — clique pra trocar">
          <Border Width="28" Height="28" Background="{Binding BrushColorHex}" BorderBrush="{StaticResource Fg}" BorderThickness="1" />
        </ToggleButton>
        <Popup IsOpen="{Binding IsChecked, ElementName=ColorSwatchToggle}" PlacementTarget="{Binding ElementName=ColorSwatchToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               Closed="OnColorPopupClosed">
          <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Padding="8">
            <StackPanel Width="190">
              <TextBlock Text="Cores" FontWeight="Bold" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding Palette}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Width="28" Height="22" Margin="1" Padding="0" BorderThickness="1" BorderBrush="{StaticResource BorderDim}" Background="{Binding}" Click="OnPaletteClick" ToolTip="{Binding}" />
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Histórico (conta-gotas)" FontSize="10" Foreground="{StaticResource FgDim}" Margin="0,6,0,3" />
              <ItemsControl ItemsSource="{Binding ColorHistory}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Width="28" Height="22" Margin="1" Padding="0" BorderThickness="1" BorderBrush="{StaticResource BorderDim}" Background="{Binding}" Click="OnPaletteClick" ToolTip="{Binding}" />
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
      <StackPanel Orientation="Horizontal"><Button AutomationProperties.Name="Pincéis" Tag="{x:Static vm:EditorTool.Brush}" Click="OnEditorCategoryClick" ToolTip="Pincéis">
  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource EditorCategory}"><Style.Triggers>
    <DataTrigger Binding="{Binding IsPaintingTool}" Value="True">
      <Setter Property="Background" Value="{StaticResource SelectionBg}" /><Setter Property="BorderBrush" Value="{StaticResource Selection}" />
    </DataTrigger>
  </Style.Triggers></Style></Button.Style>
  <StackPanel><TextBlock Text="✎" FontSize="21" HorizontalAlignment="Center" /><TextBlock Text="Pincéis" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel>
</Button>
<Button AutomationProperties.Name="Formas 2D" Tag="{x:Static vm:EditorTool.Shape}" Click="OnEditorCategoryClick" ToolTip="Formas 2D">
  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource EditorCategory}"><Style.Triggers>
    <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Shape}">
      <Setter Property="Background" Value="{StaticResource SelectionBg}" /><Setter Property="BorderBrush" Value="{StaticResource Selection}" />
    </DataTrigger>
  </Style.Triggers></Style></Button.Style>
  <StackPanel><TextBlock Text="▱" FontSize="21" HorizontalAlignment="Center" /><TextBlock Text="Formas 2D" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel>
</Button>
<Button AutomationProperties.Name="Texto" Tag="{x:Static vm:EditorTool.Text}" Click="OnEditorCategoryClick" ToolTip="Texto">
  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource EditorCategory}"><Style.Triggers>
    <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Text}">
      <Setter Property="Background" Value="{StaticResource SelectionBg}" /><Setter Property="BorderBrush" Value="{StaticResource Selection}" />
    </DataTrigger>
  </Style.Triggers></Style></Button.Style>
  <StackPanel><TextBlock Text="T" FontSize="21" HorizontalAlignment="Center" /><TextBlock Text="Texto" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel>
</Button>
<Button AutomationProperties.Name="Camadas" Tag="{x:Static vm:EditorTool.Layers}" Click="OnEditorCategoryClick" ToolTip="Camadas">
  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource EditorCategory}"><Style.Triggers>
    <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Layers}">
      <Setter Property="Background" Value="{StaticResource SelectionBg}" /><Setter Property="BorderBrush" Value="{StaticResource Selection}" />
    </DataTrigger>
  </Style.Triggers></Style></Button.Style>
  <StackPanel><TextBlock Text="▧" FontSize="21" HorizontalAlignment="Center" /><TextBlock Text="Camadas" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel>
</Button>
<Button AutomationProperties.Name="Tela" Tag="{x:Static vm:EditorTool.Canvas}" Click="OnEditorCategoryClick" ToolTip="Tela">
  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource EditorCategory}"><Style.Triggers>
    <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Canvas}">
      <Setter Property="Background" Value="{StaticResource SelectionBg}" /><Setter Property="BorderBrush" Value="{StaticResource Selection}" />
    </DataTrigger>
  </Style.Triggers></Style></Button.Style>
  <StackPanel><TextBlock Text="▣" FontSize="21" HorizontalAlignment="Center" /><TextBlock Text="Tela" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel>
</Button>
<Button AutomationProperties.Name="Recortar" Tag="{x:Static vm:EditorTool.Crop}" Click="OnEditorCategoryClick" ToolTip="Recortar">
  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource EditorCategory}"><Style.Triggers>
    <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Crop}">
      <Setter Property="Background" Value="{StaticResource SelectionBg}" /><Setter Property="BorderBrush" Value="{StaticResource Selection}" />
    </DataTrigger>
  </Style.Triggers></Style></Button.Style>
  <StackPanel><TextBlock Text="⌗" FontSize="21" HorizontalAlignment="Center" /><TextBlock Text="Recortar" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel>
</Button></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="2" x:Name="EditorWorkspace">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="520" /><ColumnDefinition Width="6" /><ColumnDefinition Width="0.34*" MinWidth="280" MaxWidth="360" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource SurfacePanel}" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderDim}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel><TextBlock DockPanel.Dock="Left" Text="ÁREA DE EDIÇÃO" Style="{StaticResource SectionTitle}" /><TextBlock HorizontalAlignment="Right" Foreground="{StaticResource FgDim}" FontSize="11"><Run Text="{Binding Bitmap.Width, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Bitmap.Height, Mode=OneWay}" /><Run Text=" px" /></TextBlock></DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderDim}" BorderThickness="0,1,0,0" Padding="8,6">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button AutomationProperties.Name="Afastar visualização" Content="−" Click="OnZoomOutClick" Width="28" ToolTip="Afastar visualização" />
                <TextBlock x:Name="ZoomLabel" Text="100% do ajuste" Width="104" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                <Button AutomationProperties.Name="Aproximar visualização" Content="+" Click="OnZoomInClick" Width="28" ToolTip="Aproximar visualização" Margin="0,0,6,0" />
                <Button AutomationProperties.Name="Restaurar o enquadramento da imagem" Content="Ajustar à tela" Click="OnFitCanvasClick" ToolTip="Restaurar o enquadramento da imagem" />
              </StackPanel>
              <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding SnapEnabled}" Click="OnSnapToggled" Padding="8,3" Margin="0,0,10,0"
                            AutomationProperties.Name="Ímãs de alinhamento"
                            ToolTip="Ímãs: ao mover uma camada ela gruda no centro e nas bordas da tela e das outras camadas. Segure Alt pra mover livre.">
                <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                  <Setter Property="Content" Value="🧲 Ímãs: desligados" />
                  <Style.Triggers><Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="🧲 Ímãs: ligados" />
                    <Setter Property="Background" Value="{StaticResource SelectionBg}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Selection}" />
                  </Trigger></Style.Triggers>
                </Style></ToggleButton.Style>
              </ToggleButton>
              <TextBlock Text="Roda do mouse para aproximar" TextTrimming="CharacterEllipsis" Foreground="{StaticResource FgDim}" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Background="{StaticResource InputBg}" ClipToBounds="True">
            <skia:SKElement x:Name="Canvas" PaintSurface="OnPaintSurface" MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp" MouseWheel="OnCanvasMouseWheel" ToolTip="Roda do mouse: afasta/aproxima a visualização" />
          </Border>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Style="{StaticResource WorkspaceSplitter}" AutomationProperties.Name="Largura das opções da ferramenta" />
      <Border Grid.Column="2" Style="{StaticResource SurfacePanel}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="OPÇÕES DA FERRAMENTA" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
          <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" BorderBrush="{StaticResource BorderDim}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Crop}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Canvas}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel>
              <Border Background="{StaticResource SelectionBg}" BorderBrush="{StaticResource Selection}" BorderThickness="1" Padding="10,10" Cursor="Hand" PreviewMouseLeftButtonDown="OnDragChipDown" PreviewMouseMove="OnDragChipMove" ToolTip="Salva a imagem e inicia o arraste para uma célula da grade">
                <TextBlock Text="Arraste para a grade" FontWeight="SemiBold" HorizontalAlignment="Center" />
              </Border>
              <TextBlock Text="A imagem é salva ao iniciar o arraste." TextWrapping="Wrap" Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <!-- ═══ RECORTAR (Paint 3D: presets, W/H, fixar proporção, Cancelar/Concluído) ═══ -->
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Crop}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Recortar" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="Escolha seu enquadramento" Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding AspectPresets}" SelectedItem="{Binding SelectedPreset}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Width="72" Height="42" Margin="1">
                    <TextBlock Text="{Binding Name}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="Largura" FontSize="11" />
                <TextBox x:Name="CropW" LostFocus="OnCropFieldChanged" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Text="Altura" FontSize="11" />
                <TextBox x:Name="CropH" LostFocus="OnCropFieldChanged" />
              </StackPanel>
            </Grid>
            <TextBlock Text="A proporção é definida pelo enquadramento selecionado acima. Use Livre para ajustar sem proporção."
                       TextWrapping="Wrap" Foreground="{StaticResource FgDim}" FontSize="10" Margin="0,8,0,10" />
            <Button Content="Selecionar imagem inteira" Click="OnSelectFullCrop" Margin="0,0,0,8" Padding="0,6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Redefinir" Click="OnCropCancel" Margin="0,0,3,0" Padding="0,6" />
              <Button Grid.Column="1" Content="Aplicar recorte" Click="OnApplyCrop" Margin="3,0,0,0" Padding="0,6"
                      Background="{StaticResource SelectionBg}" BorderBrush="{StaticResource Selection}" FontWeight="Bold" />
            </Grid>
            <TextBlock Text="Arraste fora do quadro para criar outro recorte · dentro para mover · alças para ajustar · Enter aplica · Esc redefine"
                       Foreground="{StaticResource FgDim}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>

          <!-- ═══ CAMADAS: sobrepor imagens (o "adesivo" do Paint 3D) ═══ -->
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Layers}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Camadas" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
            <Button AutomationProperties.Name="Selecionar o fundo" Click="OnSelectBaseLayer" HorizontalContentAlignment="Stretch" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderDim}" Padding="8" Margin="0,0,0,8" ToolTip="Selecionar o fundo (os pincéis passam a pintar nele)">
              <DockPanel><TextBlock DockPanel.Dock="Left" Text="▣" FontSize="16" Margin="0,0,8,0" /><StackPanel><TextBlock Text="Fundo (tela)" FontWeight="SemiBold" /><TextBlock Text="Fica atrás de tudo · Tela/Recortar mudam o tamanho" FontSize="10" Foreground="{StaticResource FgDim}" /></StackPanel></DockPanel>
            </Button>
            <Button Content="＋ Adicionar imagem" Click="OnAddLayer" Padding="0,6" Margin="0,0,0,8"
                    Background="{StaticResource SelectionBg}" BorderBrush="{StaticResource Selection}" />

            <!-- Mais alta primeiro, como em qualquer editor de camadas -->
            <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding ActiveLayer, Mode=TwoWay}"
                     MaxHeight="220" Margin="0,0,0,6">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel MinWidth="185">
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Visible}" Margin="0,0,5,0"
                              VerticalAlignment="Center" ToolTip="Mostrar/ocultar" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding KindIcon}" Width="18" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button AutomationProperties.Name="Subir (fica por cima)" Grid.Column="0" Content="▲" Command="{Binding MoveLayerUpCommand}" CommandParameter="{Binding ActiveLayer}"
                      Margin="0,0,2,0" Padding="0,4" ToolTip="Subir (fica por cima)" />
              <Button AutomationProperties.Name="Descer" Grid.Column="1" Content="▼" Command="{Binding MoveLayerDownCommand}" CommandParameter="{Binding ActiveLayer}"
                      Margin="2,0" Padding="0,4" ToolTip="Descer" />
              <Button AutomationProperties.Name="Remover camada" Grid.Column="2" Content="Excluir" Command="{Binding RemoveLayerCommand}" CommandParameter="{Binding ActiveLayer}"
                      Margin="2,0,0,0" Padding="0,4" ToolTip="Remover camada" />
            </Grid>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Centralizar" Command="{Binding CenterLayerCommand}" CommandParameter="both" Margin="0,0,2,0" Padding="0,4" ToolTip="Centro da tela (horizontal e vertical)" />
              <Button Grid.Column="1" Content="Centro ↔" Command="{Binding CenterLayerCommand}" CommandParameter="h" Margin="2,0" Padding="0,4" ToolTip="Centralizar só na horizontal" />
              <Button Grid.Column="2" Content="Centro ↕" Command="{Binding CenterLayerCommand}" CommandParameter="v" Margin="2,0,0,0" Padding="0,4" ToolTip="Centralizar só na vertical" />
            </Grid>
            <Button Content="Ocupar a tela" Command="{Binding FitLayerToCanvasCommand}" Padding="0,4" Margin="0,0,0,8" ToolTip="Camada ocupa a tela inteira (imagem e texto mantêm a proporção)" />
            <TextBlock Text="Opacidade" FontSize="11" />
            <Slider Minimum="0" Maximum="1" Value="{Binding ActiveLayer.Opacity, Mode=TwoWay, FallbackValue=1}"
                    IsEnabled="{Binding HasLayers}" Margin="0,0,0,8" />

            <Button Content="Mesclar camadas na imagem" Command="{Binding FlattenLayersCommand}"
                    IsEnabled="{Binding HasLayers}" Padding="0,6" />
            <TextBlock Text="A imagem original também é uma camada, separada do fundo. Arraste pra mover · cantos redimensionam (Shift deforma) · Del exclui · salvar já sai com tudo junto; mesclar só quando quiser fixar."
                       Foreground="{StaticResource FgDim}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>

          <!-- ═══ TELA (Paint 3D: W/H, fixar proporção, redimensionar imagem com a tela, guias) ═══ -->
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Canvas}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Tela" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="Redimensionar a tela" Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,0,0,6" />
            <!-- Unidade (Paint 3D tem o mesmo seletor): em PORCENTAGEM os campos viram
                 100/100 e o valor é relativo ao tamanho atual. -->
            <ComboBox x:Name="TelaUnit" SelectedIndex="0" Margin="0,0,0,6" SelectionChanged="OnTelaUnitChanged">
              <ComboBoxItem Content="Pixels" />
              <ComboBoxItem Content="Porcentagem" />
            </ComboBox>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="Largura" FontSize="11" />
                <TextBox x:Name="TelaW" TextChanged="OnTelaFieldChanged"
                         KeyDown="OnTelaKeyDown" LostFocus="OnTelaCommit" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Text="Altura" FontSize="11" />
                <TextBox x:Name="TelaH" TextChanged="OnTelaFieldChanged"
                         KeyDown="OnTelaKeyDown" LostFocus="OnTelaCommit" />
              </StackPanel>
            </Grid>
            <CheckBox Content="Fixar proporção" IsChecked="{Binding LockAspect}" Margin="0,8,0,4" />
            <CheckBox Content="Redimensionar imagem com a tela" IsChecked="{Binding ResizeImageWithCanvas}" Margin="0,0,0,4" />
            <CheckBox Content="Tela transparente" IsChecked="{Binding TransparentCanvas}" Margin="0,0,0,10"
                      ToolTip="A área nova entra transparente em vez de branca" />
            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Redefinir" Click="OnResetCanvas" Padding="0,6" Margin="0,0,3,0" />
            <Button x:Name="ApplyCanvasButton" Grid.Column="1" Content="Aplicar tamanho" Click="OnApplyCanvas" Padding="0,6" Margin="3,0,0,0"
                    Style="{StaticResource ApplyCanvasStyle}" ToolTip="Acende quando há um tamanho novo pendente" />
            </Grid>
            <TextBlock Text="Ou arraste as guias em qualquer borda/canto da imagem — a arte original sempre fica centralizada na tela nova."
                       Foreground="{StaticResource FgDim}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>


<StackPanel>
  <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
    <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Brush}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
<DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Eraser}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
<DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Bucket}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
<DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Eyedropper}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
  </Style.Triggers></Style></StackPanel.Style>
<TextBlock Text="Pincéis" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
<TextBlock Text="Escolha como pintar ou preencher a imagem." TextWrapping="Wrap" Foreground="{StaticResource FgDim}" Margin="0,0,0,6" />
<TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"><Run Text="Pintando em: " Foreground="{StaticResource FgDim}" /><Run Text="{Binding PaintTargetName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" (troque em Camadas)" Foreground="{StaticResource FgDim}" /></TextBlock>
<UniformGrid Columns="2">
<RadioButton GroupName="PaintTool" Style="{StaticResource PaintToolChoice}" AutomationProperties.Name="Pincel" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Brush}}">
  <StackPanel><Path Data="{StaticResource IconBrush}" Fill="{StaticResource Fg}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Text="Pincel" Margin="0,5,0,0" HorizontalAlignment="Center" /></StackPanel>
</RadioButton>
<RadioButton GroupName="PaintTool" Style="{StaticResource PaintToolChoice}" AutomationProperties.Name="Borracha" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Eraser}}">
  <StackPanel><Path Data="{StaticResource IconEraser}" Fill="{StaticResource Fg}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Text="Borracha" Margin="0,5,0,0" HorizontalAlignment="Center" /></StackPanel>
</RadioButton>
<RadioButton GroupName="PaintTool" Style="{StaticResource PaintToolChoice}" AutomationProperties.Name="Preencher" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Bucket}}">
  <StackPanel><Path Data="{StaticResource IconBucket}" Fill="{StaticResource Fg}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Text="Preencher" Margin="0,5,0,0" HorizontalAlignment="Center" /></StackPanel>
</RadioButton>
<RadioButton GroupName="PaintTool" Style="{StaticResource PaintToolChoice}" AutomationProperties.Name="Conta-gotas" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Eyedropper}}">
  <StackPanel><Path Data="{StaticResource IconEyedropper}" Fill="{StaticResource Fg}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Text="Conta-gotas" Margin="0,5,0,0" HorizontalAlignment="Center" /></StackPanel>
</RadioButton>
</UniformGrid>
</StackPanel>
<StackPanel>
  <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
    <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Shape}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
  </Style.Triggers></Style></StackPanel.Style>
<TextBlock Text="Formas 2D" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />          <TextBlock Text="Forma" FontSize="11" Margin="0,8,0,2" />
          <ComboBox ItemsSource="{Binding Shapes}" SelectedItem="{Binding Shape}" />
          <CheckBox Content="Preenchida" IsChecked="{Binding ShapeFilled}" Margin="0,4,0,0" />
          <TextBlock Text="Arraste na imagem pra desenhar — ao soltar, a forma vira camada. Depois: arraste por dentro pra mover, cantos pra redimensionar (Shift mantém proporção). Com a forma selecionada, cor/preenchimento/espessura mudam ela. Del exclui."
                     Foreground="{StaticResource FgDim}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />

</StackPanel>
<StackPanel>
  <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
    <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Text}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
  </Style.Triggers></Style></StackPanel.Style>
<TextBlock Text="Texto" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />          <TextBlock Text="Texto" FontSize="11" Margin="0,8,0,2" />
          <TextBox Text="{Binding TextInput, UpdateSourceTrigger=PropertyChanged}" />
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Tamanho" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding TextSize, UpdateSourceTrigger=PropertyChanged}" Width="56" HorizontalAlignment="Left" />
          </DockPanel>
<TextBlock Text="Clique na imagem pra inserir no tamanho acima, ou ARRASTE uma caixa: a altura dela define o tamanho da letra. O texto vira camada — arraste pra mover, cantos pra redimensionar. Com o texto selecionado, editar o campo, o tamanho ou a cor muda ele. Del exclui." TextWrapping="Wrap" Foreground="{StaticResource FgDim}" FontSize="10" Margin="0,8,0,0" />
</StackPanel>
<StackPanel>
  <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
    <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Brush}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
<DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Eraser}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
<DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Shape}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
  </Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="Pincel / contorno" FontSize="11" Margin="0,8,0,2" />
          <DockPanel>
            <TextBox DockPanel.Dock="Right" Text="{Binding BrushSize, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="6,0,0,0" />
            <Slider Minimum="1" Maximum="100" Value="{Binding BrushSize}" VerticalAlignment="Center" />
          </DockPanel>


</StackPanel>
<StackPanel>
  <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
    <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Bucket}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
  </Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="Tolerância do balde" FontSize="11" Margin="0,8,0,2" />
          <DockPanel>
            <TextBox DockPanel.Dock="Right" Text="{Binding BucketTolerance, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="6,0,0,0" />
            <Slider Minimum="0" Maximum="128" Value="{Binding BucketTolerance}" VerticalAlignment="Center" />
          </DockPanel>


</StackPanel>
<StackPanel>
  <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
    <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Brush}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
<DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Eyedropper}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
<DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Bucket}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
<DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Shape}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
<DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Text}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
  </Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="Cores" FontSize="13" FontWeight="Bold" Margin="0,14,0,4" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Border Background="{Binding BrushColorHex}" Width="26" Height="26" BorderBrush="{StaticResource Fg}"
                    BorderThickness="1" Margin="0,0,6,0" ToolTip="Cor atual" />
            <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Width="176" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="26" Height="20" Margin="1" Padding="0" BorderThickness="1"
                          BorderBrush="{StaticResource BorderDim}" Background="{Binding}"
                          Click="OnPaletteClick" ToolTip="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Margin="0,6,0,0">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ColorHistory.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Histórico (conta-gotas)" FontSize="10" Foreground="{StaticResource FgDim}" Margin="0,0,0,3" />
            <ItemsControl ItemsSource="{Binding ColorHistory}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Width="176" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="26" Height="20" Margin="1" Padding="0" BorderThickness="1"
                          BorderBrush="{StaticResource BorderDim}" Background="{Binding}"
                          Click="OnPaletteClick" ToolTip="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>


</StackPanel>
          </StackPanel></ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" Margin="4,0" />
  </Grid>
</Window>
