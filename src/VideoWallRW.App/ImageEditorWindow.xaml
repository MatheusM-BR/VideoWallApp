<Window x:Class="VideoWallRW.App.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:vm="clr-namespace:VideoWallRW.App.ViewModels"
        Title="Editor de imagem" Height="720" Width="1000"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <ToggleButton Content="Cortar" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Crop}}" Padding="8,4" Margin="0,0,4,0" />
      <ToggleButton Content="Pincel" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Brush}}" Padding="8,4" Margin="0,0,12,0" />
      <ToggleButton Content="Texto" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Text}}" Padding="8,4" Margin="0,0,12,0" />

      <TextBlock Text="Proporção" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox ItemsSource="{Binding AspectPresets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset}" Width="110" Margin="0,0,12,0" />

      <TextBlock Text="Cor" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox x:Name="ColorPicker" Width="90" Margin="0,0,12,0" SelectionChanged="OnColorChanged">
        <ComboBoxItem Content="Vermelho" Tag="Red" IsSelected="True" />
        <ComboBoxItem Content="Preto" Tag="Black" />
        <ComboBoxItem Content="Branco" Tag="White" />
        <ComboBoxItem Content="Amarelo" Tag="Yellow" />
      </ComboBox>

      <TextBlock Text="Tam. pincel" VerticalAlignment="Center" Margin="0,0,4,0" />
      <TextBox Text="{Binding BrushSize, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,12,0" />

      <TextBlock Text="Texto" VerticalAlignment="Center" Margin="0,0,4,0" />
      <TextBox Text="{Binding TextInput, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,12,0" />

      <Button Content="↶" Command="{Binding UndoCommand}" Padding="8,4" Margin="0,0,2,0" ToolTip="Desfazer" />
      <Button Content="↷" Command="{Binding RedoCommand}" Padding="8,4" Margin="0,0,12,0" ToolTip="Refazer" />

      <Button Content="Aplicar corte" Click="OnApplyCrop" Padding="8,4" Margin="0,0,12,0" />
      <Button Content="Salvar" Command="{Binding SaveCommand}" Padding="8,4" Margin="0,0,4,0" />
      <Button Content="Salvar e enviar para célula" Command="{Binding SaveAndSendToCellCommand}" Padding="8,4" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Foreground="#666" Margin="0,6,0,0" />

    <Border BorderBrush="#888" BorderThickness="1" Background="#DDD" ClipToBounds="True">
      <skia:SKElement x:Name="Canvas" PaintSurface="OnPaintSurface"
                       MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp" />
    </Border>
  </DockPanel>
</Window>
