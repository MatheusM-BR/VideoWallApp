<Window x:Class="VideoWallRW.App.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:vm="clr-namespace:VideoWallRW.App.ViewModels"
        Title="Editor de imagem" Height="760" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <DockPanel Margin="10">

    <!-- Linha 1: ferramentas -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
      <ToggleButton Content="✂ Cortar" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Crop}}" Padding="8,4" Margin="0,0,3,0" />
      <ToggleButton Content="🖌 Pincel" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Brush}}" Padding="8,4" Margin="0,0,3,0" />
      <ToggleButton Content="⌫ Borracha" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Eraser}}" Padding="8,4" Margin="0,0,3,0" />
      <ToggleButton Content="💧 Conta-gotas" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Eyedropper}}" Padding="8,4" Margin="0,0,3,0" />
      <ToggleButton Content="🪣 Balde" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Bucket}}" Padding="8,4" Margin="0,0,3,0" />
      <ToggleButton Content="⬜ Forma" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Shape}}" Padding="8,4" Margin="0,0,3,0" />
      <ToggleButton Content="🅰 Texto" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Text}}" Padding="8,4" Margin="0,0,14,0" />

      <Button Content="Tela / Redimensionar..." Click="OnCanvasSize" Padding="8,4" Margin="0,0,14,0" />

      <Button Content="↶" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Padding="8,4" Margin="0,0,2,0" ToolTip="Desfazer" />
      <Button Content="↷" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Padding="8,4" Margin="0,0,14,0" ToolTip="Refazer" />

      <Button Content="Salvar" Command="{Binding SaveCommand}" Padding="10,4" Margin="0,0,3,0" />
      <Button Content="Salvar e enviar p/ célula" Command="{Binding SaveAndSendToCellCommand}" Padding="10,4" />
    </StackPanel>

    <!-- Linha 2: opções da ferramenta ativa -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <!-- Paleta -->
      <Border Background="{Binding BrushColorHex}" Width="24" Height="24" BorderBrush="{StaticResource Fg}"
              BorderThickness="1" Margin="0,0,6,0" ToolTip="Cor atual" />
      <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center" Margin="0,0,14,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="18" Height="18" Margin="1,0" Padding="0" BorderThickness="1"
                    BorderBrush="{StaticResource BorderDim}" Background="{Binding}"
                    Click="OnPaletteClick" ToolTip="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Espessura" VerticalAlignment="Center" Margin="0,0,4,0" />
      <TextBox Text="{Binding BrushSize, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="0,0,12,0" />

      <TextBlock Text="Forma" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox ItemsSource="{Binding Shapes}" SelectedItem="{Binding Shape}" Width="96" Margin="0,0,4,0" />
      <CheckBox Content="Preenchida" IsChecked="{Binding ShapeFilled}" VerticalAlignment="Center" Margin="0,0,12,0" />

      <TextBlock Text="Tolerância balde" VerticalAlignment="Center" Margin="0,0,4,0" />
      <TextBox Text="{Binding BucketTolerance, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="0,0,12,0" />

      <TextBlock Text="Proporção corte" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox ItemsSource="{Binding AspectPresets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset}" Width="110" Margin="0,0,4,0" />
      <Button Content="Aplicar corte" Click="OnApplyCrop" Padding="8,4" Margin="0,0,12,0" />

      <TextBlock Text="Texto" VerticalAlignment="Center" Margin="0,0,4,0" />
      <TextBox Text="{Binding TextInput, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,4,0" />
      <TextBox Text="{Binding TextSize, UpdateSourceTrigger=PropertyChanged}" Width="36" ToolTip="Tamanho da fonte" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Foreground="{StaticResource FgDim}" Margin="0,6,0,0"
               TextTrimming="CharacterEllipsis" />

    <Border BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Background="{StaticResource InputBg}" ClipToBounds="True">
      <skia:SKElement x:Name="Canvas" PaintSurface="OnPaintSurface"
                       MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp" />
    </Border>
  </DockPanel>
</Window>
