<Window x:Class="VideoWallRW.App.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:vm="clr-namespace:VideoWallRW.App.ViewModels"
        Title="Editor de imagem" Height="780" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <DockPanel Margin="10">

    <!-- Barra superior: ferramentas (as opções ficam no painel lateral, como no Paint 3D) -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <ToggleButton Content="✂ Recortar" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Crop}}" Padding="10,5" Margin="0,0,3,0" />
      <ToggleButton Content="⛶ Tela" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Canvas}}" Padding="10,5" Margin="0,0,3,0" />
      <ToggleButton Content="🖌 Pincel" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Brush}}" Padding="10,5" Margin="0,0,3,0" />
      <ToggleButton Content="⌫ Borracha" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Eraser}}" Padding="10,5" Margin="0,0,3,0" />
      <ToggleButton Content="💧 Conta-gotas" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Eyedropper}}" Padding="10,5" Margin="0,0,3,0" />
      <ToggleButton Content="🪣 Balde" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Bucket}}" Padding="10,5" Margin="0,0,3,0" />
      <ToggleButton Content="⬜ Forma" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Shape}}" Padding="10,5" Margin="0,0,3,0" />
      <ToggleButton Content="🅰 Texto" IsChecked="{Binding Tool, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static vm:EditorTool.Text}}" Padding="10,5" Margin="0,0,14,0" />

      <Button Content="↶" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Padding="10,5" Margin="0,0,2,0" ToolTip="Desfazer" />
      <Button Content="↷" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Padding="10,5" Margin="0,0,14,0" ToolTip="Refazer" />

      <Button Content="💾 Salvar" Command="{Binding SaveCommand}" Padding="12,5" Margin="0,0,6,0" />
      <!-- Arrastar direto pra célula da grade (salva automaticamente ao iniciar o arraste) -->
      <Border Background="{StaticResource AccentDim}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
              CornerRadius="3" Padding="12,5" Cursor="Hand"
              PreviewMouseLeftButtonDown="OnDragChipDown" PreviewMouseMove="OnDragChipMove"
              ToolTip="Segure e arraste até a célula da grade onde a imagem deve entrar (salva automaticamente)">
        <TextBlock Text="🖼 ARRASTE p/ célula" FontWeight="Bold" />
      </Border>
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Foreground="{StaticResource FgDim}" Margin="0,6,0,0"
               TextTrimming="CharacterEllipsis" />

    <!-- Painel lateral direito (estilo Paint 3D): opções da ferramenta ativa -->
    <Border DockPanel.Dock="Right" Width="230" Margin="8,0,0,0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Padding="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <!-- ═══ RECORTAR (Paint 3D: presets, W/H, fixar proporção, Cancelar/Concluído) ═══ -->
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Crop}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Recortar" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="Escolha seu enquadramento" Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding AspectPresets}" SelectedItem="{Binding SelectedPreset}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Width="60" Height="42" Margin="1">
                    <TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="Largura" FontSize="11" />
                <TextBox x:Name="CropW" LostFocus="OnCropFieldChanged" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Text="Altura" FontSize="11" />
                <TextBox x:Name="CropH" LostFocus="OnCropFieldChanged" />
              </StackPanel>
            </Grid>
            <CheckBox Content="Fixar proporção" IsChecked="{Binding LockAspect}" Margin="0,8,0,10" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Cancelar" Click="OnCropCancel" Margin="0,0,3,0" Padding="0,6" />
              <Button Grid.Column="1" Content="Concluído" Click="OnApplyCrop" Margin="3,0,0,0" Padding="0,6"
                      Background="{StaticResource AccentDim}" BorderBrush="{StaticResource Accent}" FontWeight="Bold" />
            </Grid>
            <TextBlock Text="Arraste na imagem para selecionar; arraste os cantos para ajustar; arraste por dentro para mover."
                       Foreground="{StaticResource FgDim}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>

          <!-- ═══ TELA (Paint 3D: W/H, fixar proporção, redimensionar imagem com a tela, guias) ═══ -->
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Tool}" Value="{x:Static vm:EditorTool.Canvas}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Tela" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="Redimensionar a tela" Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,0,0,6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="Largura" FontSize="11" />
                <TextBox x:Name="TelaW" TextChanged="OnTelaFieldChanged" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Text="Altura" FontSize="11" />
                <TextBox x:Name="TelaH" TextChanged="OnTelaFieldChanged" />
              </StackPanel>
            </Grid>
            <CheckBox Content="Fixar proporção" IsChecked="{Binding LockAspect}" Margin="0,8,0,4" />
            <CheckBox Content="Redimensionar imagem com a tela" IsChecked="{Binding ResizeImageWithCanvas}" Margin="0,0,0,10" />
            <Button Content="Aplicar" Click="OnApplyCanvas" Padding="0,6"
                    Background="{StaticResource AccentDim}" BorderBrush="{StaticResource Accent}" FontWeight="Bold" />
            <TextBlock Text="Ou arraste as guias em qualquer borda/canto da imagem — a arte original sempre fica centralizada na tela nova."
                       Foreground="{StaticResource FgDim}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>

          <!-- ═══ Ferramenta (cor, espessura, forma, balde, texto) — sempre visível ═══ -->
          <TextBlock Text="Cores" FontSize="13" FontWeight="Bold" Margin="0,14,0,4" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Border Background="{Binding BrushColorHex}" Width="26" Height="26" BorderBrush="{StaticResource Fg}"
                    BorderThickness="1" Margin="0,0,6,0" ToolTip="Cor atual" />
            <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Width="176" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="26" Height="20" Margin="1" Padding="0" BorderThickness="1"
                          BorderBrush="{StaticResource BorderDim}" Background="{Binding}"
                          Click="OnPaletteClick" ToolTip="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Text="Pincel / contorno" FontSize="11" Margin="0,8,0,2" />
          <DockPanel>
            <TextBox DockPanel.Dock="Right" Text="{Binding BrushSize, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="6,0,0,0" />
            <Slider Minimum="1" Maximum="100" Value="{Binding BrushSize}" VerticalAlignment="Center" />
          </DockPanel>

          <TextBlock Text="Forma" FontSize="11" Margin="0,8,0,2" />
          <ComboBox ItemsSource="{Binding Shapes}" SelectedItem="{Binding Shape}" />
          <CheckBox Content="Preenchida" IsChecked="{Binding ShapeFilled}" Margin="0,4,0,0" />

          <TextBlock Text="Tolerância do balde" FontSize="11" Margin="0,8,0,2" />
          <DockPanel>
            <TextBox DockPanel.Dock="Right" Text="{Binding BucketTolerance, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="6,0,0,0" />
            <Slider Minimum="0" Maximum="128" Value="{Binding BucketTolerance}" VerticalAlignment="Center" />
          </DockPanel>

          <TextBlock Text="Texto" FontSize="11" Margin="0,8,0,2" />
          <TextBox Text="{Binding TextInput, UpdateSourceTrigger=PropertyChanged}" />
          <DockPanel Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Tamanho" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding TextSize, UpdateSourceTrigger=PropertyChanged}" Width="46" HorizontalAlignment="Left" />
          </DockPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Background="{StaticResource InputBg}" ClipToBounds="True">
      <skia:SKElement x:Name="Canvas" PaintSurface="OnPaintSurface"
                       MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp" />
    </Border>
  </DockPanel>
</Window>
