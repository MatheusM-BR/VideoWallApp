<Window x:Class="VideoWallRW.App.PdfImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Importar página do PDF" Height="640" Width="700"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="Página" VerticalAlignment="Center" Margin="0,0,4,0" />
      <TextBox Text="{Binding PageNumber, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,4,0" />
      <TextBlock Text="{Binding PageCount, StringFormat=' de {0}'}" VerticalAlignment="Center" Margin="0,0,16,0" />
      <TextBlock Text="DPI" VerticalAlignment="Center" Margin="0,0,4,0" />
      <TextBox Text="{Binding Dpi, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,16,0" />
      <Button Content="Exportar página" Command="{Binding ExportPageCommand}" Padding="10,4" />
      <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="10,0,0,0" />
    </StackPanel>
    <Border BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Background="{StaticResource InputBg}">
      <skia:SKElement x:Name="PreviewElement" PaintSurface="OnPaintSurface" />
    </Border>
  </DockPanel>
</Window>
