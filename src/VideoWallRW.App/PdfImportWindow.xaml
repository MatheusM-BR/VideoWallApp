<Window x:Class="VideoWallRW.App.PdfImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Imagens do PDF — VideoWallRW" Height="760" Width="1100" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Auxiliary.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <DockPanel Margin="8" Background="{StaticResource Bg}">
    <Border DockPanel.Dock="Top" Style="{StaticResource SurfacePanel}" Margin="0,0,0,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Exportar e abrir no editor" Command="{Binding ExportPageCommand}">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryAction}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <StackPanel><TextBlock Text="Imagens do PDF" Style="{StaticResource PageTitle}" /><TextBlock Text="Selecione uma página para transformar em imagem." Foreground="{StaticResource FgDim}" Margin="0,4,0,0" /></StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource SurfacePanel}" Padding="10,8" Margin="0,6,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"><TextBlock Text="Resolução (DPI)" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox Text="{Binding Dpi, UpdateSourceTrigger=LostFocus}" Width="64" Padding="6,4" ToolTip="Resolução usada para exportar a página" /></StackPanel>
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Left" Width="190" Style="{StaticResource SurfacePanel}" Padding="8" Margin="0,0,6,0">
    <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding PageCount, StringFormat='PÁGINAS · {0}'}" Style="{StaticResource SectionTitle}" Margin="4,4,4,12" />

    <!-- Miniaturas das páginas na lateral: clicar abre a prévia grande -->
    <ListBox HorizontalContentAlignment="Stretch" BorderThickness="0"
             ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2">
            <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderDim}"
                    BorderThickness="1" Height="150">
              <Image Source="{Binding Image}" Stretch="Uniform" />
            </Border>
            <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </DockPanel>
    </Border>

    <Border Style="{StaticResource SurfacePanel}" Padding="0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{StaticResource BorderDim}" BorderThickness="0,0,0,1"><TextBlock Text="{Binding SelectedPage.Label, TargetNullValue=PRÉVIA DA PÁGINA}" Style="{StaticResource SectionTitle}" /></Border>
        <Border Background="{StaticResource InputBg}" ClipToBounds="True">
      <skia:SKElement x:Name="PreviewElement" PaintSurface="OnPaintSurface" />
        </Border>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
