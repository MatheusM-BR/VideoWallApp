<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Máquinas com só um runtime .NET mais novo instalado (sem o 8.x exato) ainda
         conseguem rodar — evita a falha silenciosa de resolução de host observada em
         ambientes com .NET 8 Desktop mas sem o ASP.NET Core 8 Runtime específico. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- T9.5: controle remoto web (Kestrel embutido) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoWallRW.Core\VideoWallRW.Core.csproj" />
    <ProjectReference Include="..\VideoWallRW.Engine\VideoWallRW.Engine.csproj" />
    <ProjectReference Include="..\VideoWallRW.Media\VideoWallRW.Media.csproj" />
    <ProjectReference Include="..\VideoWallRW.Sources\VideoWallRW.Sources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
