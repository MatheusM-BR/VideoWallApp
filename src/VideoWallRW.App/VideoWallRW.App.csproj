<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Máquinas com só um runtime .NET mais novo instalado (sem o 8.x exato) ainda
         conseguem rodar — evita a falha silenciosa de resolução de host observada em
         ambientes com .NET 8 Desktop mas sem o ASP.NET Core 8 Runtime específico. -->
    <RollForward>LatestMajor</RollForward>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ProtectedPackage)' == 'true'">
    <DefineConstants>$(DefineConstants);PROTECTED_PACKAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(ProtectedPackage)' == 'true'">
    <EmbeddedResource Include="$(PackagePublicKeyPath)" LogicalName="VideoWallRW.PackagePublicKey" />
  </ItemGroup>
  <Target Name="RequirePackageKey" BeforeTargets="PrepareForBuild" Condition="'$(ProtectedPackage)' == 'true'">
    <Error Condition="!Exists('$(PackagePublicKeyPath)')" Text="A protected release requires a generated package public key. Use build-installer.ps1." />
  </Target>

  <ItemGroup>
    <!-- T9.5: controle remoto web (Kestrel embutido) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ícone do app (logo RW VideoWall) — embutido como recurso WPF pra ser usado
         via pack URI no Icon="" de cada janela, além de virar o ícone do .exe (acima). -->
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\BrandMark.png" />
    <Resource Include="Assets\BrandLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prints do manual: ficam como arquivos ao lado do exe (Manual\*.png) — regerar os
         prints (tests/VideoWallRW.UiChecks/make-manual-prints.ps1) não exige mexer em código. -->
    <Content Include="Assets\Manual\*.png" CopyToOutputDirectory="PreserveNewest" Link="Manual\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoWallRW.Core\VideoWallRW.Core.csproj" />
    <ProjectReference Include="..\VideoWallRW.Engine\VideoWallRW.Engine.csproj" />
    <ProjectReference Include="..\VideoWallRW.Media\VideoWallRW.Media.csproj" />
    <ProjectReference Include="..\VideoWallRW.Sources\VideoWallRW.Sources.csproj" />
    <ProjectReference Include="..\VideoWallRW.Agenda\VideoWallRW.Agenda.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.8" />
  </ItemGroup>

</Project>
