<Window x:Class="VideoWallRW.App.InstallationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalação (modo fixo)" Height="600" Width="820"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <CheckBox Content="Iniciar com o Windows (--kiosk)" IsChecked="{Binding AutostartEnabled}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding StatusText}" Foreground="#666" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>

    <TabControl>
      <TabItem Header="Sequenciador">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox Content="Habilitado" IsChecked="{Binding SequencerEnabled}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <CheckBox Content="Loop" IsChecked="{Binding SequencerLoop}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="+ Passo" Padding="8,2" Command="{Binding AddStepCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Steps}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <TextBlock Text="Coluna" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBox Text="{Binding Column, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,16,0" />
                  <TextBlock Text="Segundos" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBox Text="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,16,0" />
                  <Button DockPanel.Dock="Right" Content="Remover" Padding="6,2" HorizontalAlignment="Right"
                          Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <TabItem Header="Agenda">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Top" Content="+ Regra" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,8"
                  Command="{Binding AddRuleCommand}" />
          <ListBox ItemsSource="{Binding Rules}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,6" Padding="6" Background="#FAFAFA">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                      <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBox DockPanel.Dock="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,8,0" />
                      <Button DockPanel.Dock="Right" Content="Remover" Padding="6,2" HorizontalAlignment="Right"
                              Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                      <TextBlock Text="Hora" VerticalAlignment="Center" Margin="0,0,4,0" />
                      <TextBox Text="{Binding Hour, UpdateSourceTrigger=PropertyChanged}" Width="36" />
                      <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0" />
                      <TextBox Text="{Binding Minute, UpdateSourceTrigger=PropertyChanged}" Width="36" Margin="0,0,16,0" />
                      <TextBlock Text="Ação" VerticalAlignment="Center" Margin="0,0,4,0" />
                      <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" Width="130" Margin="0,0,16,0" />
                      <TextBlock Text="Coluna/param" VerticalAlignment="Center" Margin="0,0,4,0" />
                      <TextBox Text="{Binding ColumnOrParam, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox Content="Seg" IsChecked="{Binding Monday}" Margin="0,0,8,0" />
                      <CheckBox Content="Ter" IsChecked="{Binding Tuesday}" Margin="0,0,8,0" />
                      <CheckBox Content="Qua" IsChecked="{Binding Wednesday}" Margin="0,0,8,0" />
                      <CheckBox Content="Qui" IsChecked="{Binding Thursday}" Margin="0,0,8,0" />
                      <CheckBox Content="Sex" IsChecked="{Binding Friday}" Margin="0,0,8,0" />
                      <CheckBox Content="Sáb" IsChecked="{Binding Saturday}" Margin="0,0,8,0" />
                      <CheckBox Content="Dom" IsChecked="{Binding Sunday}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <TabItem Header="Pastas monitoradas">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Top" Content="+ Pasta" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,8"
                  Command="{Binding AddWatchFolderCommand}" />
          <ListBox ItemsSource="{Binding WatchFolders}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock DockPanel.Dock="Left" Text="Camada" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBox DockPanel.Dock="Left" Text="{Binding LayerIndex, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,16,0" />
                  <Button DockPanel.Dock="Right" Content="Remover" Padding="6,2" HorizontalAlignment="Right"
                          Command="{Binding DataContext.RemoveWatchFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                  <TextBlock Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
