<Window x:Class="VideoWallRW.App.OutputSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoWallRW.App.Controls"
        Title="Mapear saídas" Height="760" Width="1180"
        MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <DockPanel Background="{StaticResource Bg}" Margin="10">
<Border DockPanel.Dock="Top" Style="{StaticResource SurfacePanel}" Margin="0,0,0,10"><StackPanel><TextBlock Text="Mapear saídas" Style="{StaticResource PageTitle}" /><TextBlock Text="Organize as telas e ajuste os recortes da composição." Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>

    <!-- Barra superior: identify + presets -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button DockPanel.Dock="Left" Content="{Binding Identify, Converter={StaticResource IdentifyLabelConverter}, FallbackValue='Identificar telas'}"
              Command="{Binding ToggleIdentifyCommand}" Padding="10,4" Margin="0,0,16,0" />
      <TextBlock DockPanel.Dock="Left" Text="Perfil:" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ComboBox DockPanel.Dock="Left" Width="140" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                ItemsSource="{Binding PresetNames}" IsEditable="True" Margin="0,0,6,0" />
      <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryAction}" Content="Salvar" Command="{Binding SavePresetCommand}" Padding="8,4" Margin="0,0,4,0" />
      <Button DockPanel.Dock="Left" Content="Carregar" Command="{Binding LoadPresetCommand}" Padding="8,4" Margin="0,0,4,0" />
      <Button DockPanel.Dock="Left" Content="Excluir" Command="{Binding DeletePresetCommand}" Padding="8,4" Margin="0,0,16,0" />
      <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <!-- Cenário (T27): mapa com TODAS as telas de uma vez, nomeadas e no lugar certo
         dentro da composição — "tela vertical na esquerda, horizontal no meio..." fica
         visível de relance, e arrastar aqui já é a forma principal de posicionar/
         redimensionar (os campos numéricos abaixo continuam existindo pra ajuste fino). -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderDim}" BorderThickness="1"
            Background="{StaticResource PanelBg}" Padding="8" Margin="0,0,0,10" Height="220">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="CENÁRIO — clique numa tela pra selecionar, arraste pra mover/redimensionar"
                   FontWeight="Bold" FontSize="11" Foreground="{StaticResource FgDim}" Margin="0,0,0,6" />
        <controls:MultiRectStageEditor
            StageWidth="{Binding CompWidth}" StageHeight="{Binding CompHeight}"
            Screens="{Binding Screens}" SelectedScreen="{Binding SelectedScreen, Mode=TwoWay}" />
      </DockPanel>
    </Border>

    <!-- Painel esquerdo: lista de telas -->
    <DockPanel DockPanel.Dock="Left" Width="220" Margin="0,0,10,0">
      <TextBlock DockPanel.Dock="Top" Text="Telas" FontWeight="Bold" Margin="0,0,0,4" />
      <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <ComboBox x:Name="MonitorPicker" DockPanel.Dock="Top" ItemsSource="{Binding AvailableMonitors}"
                  DisplayMemberPath="DeviceName" Margin="0,0,0,4" />
        <Button DockPanel.Dock="Top" Content="+ Adicionar tela" Padding="6,4"
                Command="{Binding AddScreenCommand}" CommandParameter="{Binding ElementName=MonitorPicker, Path=SelectedItem}" />
      </DockPanel>
      <ListBox x:Name="ScreenList" ItemsSource="{Binding Screens}" DisplayMemberPath="Name"
               SelectedItem="{Binding SelectedScreen, Mode=TwoWay}" />
    </DockPanel>

    <!-- Painel direito: detalhes da tela selecionada -->
    <ScrollViewer DataContext="{Binding SelectedScreen}" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Selecione uma tela à esquerda." Foreground="{StaticResource FgDim}"
                   Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Visibility="{Binding Converter={StaticResource NotNullToVisibilityConverter}}">
          <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="Nome" VerticalAlignment="Center" Width="70" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" />
            <CheckBox Content="Habilitada" IsChecked="{Binding Enabled}" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding MonitorDeviceName, StringFormat=' — {0}'}" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="10,0,0,0" />
          </DockPanel>

          <!-- T31: presets de orientação física — TV montada em pé (9:16) recebendo
               sinal deitado precisa do conteúdo girado dentro do quadro; um clique
               configura recorte 9:16 + rotação + saída cheia no primeiro slice. -->
          <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="TV física:" VerticalAlignment="Center" Width="70" />
            <Button AutomationProperties.Name="Composição inteira, sem rotação" DockPanel.Dock="Left" Content="▭ Deitada (16:9)" Padding="8,3" Margin="0,0,4,0"
                    Command="{Binding DataContext.ApplyOrientationLandscapeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="Composição inteira, sem rotação" />
            <Button AutomationProperties.Name="TV girada em sentido horário: recorte 9:16 centralizado + rotação 90°" DockPanel.Dock="Left" Content="▯ Em pé ⟳ (topo p/ direita)" Padding="8,3" Margin="0,0,4,0"
                    Command="{Binding DataContext.ApplyOrientationPortraitRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="TV girada em sentido horário: recorte 9:16 centralizado + rotação 90°" />
            <Button AutomationProperties.Name="TV girada em sentido anti-horário: recorte 9:16 centralizado + rotação 270°" DockPanel.Dock="Left" Content="▯ Em pé ⟲ (topo p/ esquerda)" Padding="8,3"
                    Command="{Binding DataContext.ApplyOrientationPortraitLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="TV girada em sentido anti-horário: recorte 9:16 centralizado + rotação 270°" />
            <Border />
          </DockPanel>

          <TextBlock Text="Correção de cor" FontWeight="Bold" Margin="0,0,0,4" />
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" /><ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" /><ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Brilho" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Brightness}" />
            <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat=F2}" Width="36" Margin="4,0,10,0" />
            <TextBlock Grid.Column="3" Text="Contraste" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Slider Grid.Column="4" Minimum="0" Maximum="2" Value="{Binding Contrast}" />
            <TextBlock Grid.Column="5" Text="{Binding Contrast, StringFormat=F2}" Width="36" Margin="4,0,10,0" />
            <TextBlock Grid.Column="6" Text="Gamma" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Slider Grid.Column="7" Minimum="0.1" Maximum="3" Value="{Binding Gamma}" />
            <TextBlock Grid.Column="8" Text="{Binding Gamma, StringFormat=F2}" Width="36" Margin="4,0,0,0" />
          </Grid>

          <DockPanel Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left" Text="Recortes" FontWeight="Bold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="+ Recorte" Padding="8,2" HorizontalAlignment="Right"
                    Command="{Binding AddSliceCommand}" />
          </DockPanel>

          <ItemsControl ItemsSource="{Binding Slices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Margin="0,0,0,8" Padding="8" Background="{StaticResource CellBg}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                      <TextBox DockPanel.Dock="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                      <ComboBox DockPanel.Dock="Left" Width="80" Margin="8,0,0,0"
                                ItemTemplate="{StaticResource OperationLabelTemplate}" ItemsSource="{Binding DataContext.Rotations, RelativeSource={RelativeSource AncestorType=Window}}"
                                SelectedItem="{Binding Rotation}" />
                      <CheckBox DockPanel.Dock="Left" Content="Espelhar H" IsChecked="{Binding FlipH}" Margin="8,0,0,0" VerticalAlignment="Center" />
                      <CheckBox DockPanel.Dock="Left" Content="Espelhar V" IsChecked="{Binding FlipV}" Margin="8,0,0,0" VerticalAlignment="Center" />
                      <Button DockPanel.Dock="Right" Content="Duplicar" Padding="6,2" HorizontalAlignment="Right"
                              Command="{Binding DataContext.DuplicateSliceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" Margin="4,0,0,0" />
                      <Button DockPanel.Dock="Right" Content="Remover" Padding="6,2" HorizontalAlignment="Right"
                              Command="{Binding DataContext.RemoveSliceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </DockPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <!-- Recorte de entrada: arrasta/redimensiona contra o tamanho da composição -->
                      <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <DockPanel Margin="0,0,0,3">
                          <TextBlock DockPanel.Dock="Left" Text="Recorte da composição (entrada)" FontSize="10"
                                     Foreground="{StaticResource FgDim}" />
                          <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold"
                                     Text="{Binding DataContext.CompResolutionText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DockPanel>
                        <Border BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Height="150">
                          <controls:RectStageEditor
                              StageWidth="{Binding DataContext.CompWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                              StageHeight="{Binding DataContext.CompHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                              BackgroundImage="{Binding DataContext.PreviewImage, RelativeSource={RelativeSource AncestorType=Window}}"
                              ImageWidth="{Binding DataContext.CompWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                              ImageHeight="{Binding DataContext.CompHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                              RectX="{Binding InputX, Mode=TwoWay}" RectY="{Binding InputY, Mode=TwoWay}"
                              RectWidth="{Binding InputWidth, Mode=TwoWay}" RectHeight="{Binding InputHeight, Mode=TwoWay}" />
                        </Border>
                        <UniformGrid Rows="1" Columns="4" Margin="0,3,0,0">
                          <TextBox Text="{Binding InputX, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" ToolTip="X" Margin="1,0" />
                          <TextBox Text="{Binding InputY, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" ToolTip="Y" Margin="1,0" />
                          <TextBox Text="{Binding InputWidth, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" ToolTip="Largura" Margin="1,0" />
                          <TextBox Text="{Binding InputHeight, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" ToolTip="Altura" Margin="1,0" />
                        </UniformGrid>
                      </StackPanel>

                      <!-- Posição de saída: arrasta/redimensiona contra o tamanho do monitor. A
                           imagem de fundo mostra só o recorte escolhido à esquerda (Crop* =
                           Input*), então dá pra ver exatamente a proporção/enquadramento que
                           vai cair nessa tela antes de tocar em brilho/contraste/gamma. -->
                      <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <DockPanel Margin="0,0,0,3">
                          <TextBlock DockPanel.Dock="Left" Text="Posição na tela (saída)" FontSize="10"
                                     Foreground="{StaticResource FgDim}" />
                          <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold"
                                     Text="{Binding DataContext.MonitorResolutionText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </DockPanel>
                        <Border BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Height="150">
                          <controls:RectStageEditor
                              StageWidth="{Binding DataContext.MonitorWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              StageHeight="{Binding DataContext.MonitorHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              BackgroundImage="{Binding DataContext.PreviewImage, RelativeSource={RelativeSource AncestorType=Window}}"
                              ImageWidth="{Binding DataContext.CompWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                              ImageHeight="{Binding DataContext.CompHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                              CropX="{Binding InputX}" CropY="{Binding InputY}"
                              CropWidth="{Binding InputWidth}" CropHeight="{Binding InputHeight}"
                              RectX="{Binding OutputX, Mode=TwoWay}" RectY="{Binding OutputY, Mode=TwoWay}"
                              RectWidth="{Binding OutputWidth, Mode=TwoWay}" RectHeight="{Binding OutputHeight, Mode=TwoWay}" />
                        </Border>
                        <UniformGrid Rows="1" Columns="4" Margin="0,3,0,0">
                          <TextBox Text="{Binding OutputX, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" ToolTip="X" Margin="1,0" />
                          <TextBox Text="{Binding OutputY, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" ToolTip="Y" Margin="1,0" />
                          <TextBox Text="{Binding OutputWidth, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" ToolTip="Largura" Margin="1,0" />
                          <TextBox Text="{Binding OutputHeight, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" ToolTip="Altura" Margin="1,0" />
                        </UniformGrid>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="Remover esta tela" HorizontalAlignment="Left" Padding="8,4" Margin="0,10,0,0"
                  Command="{Binding DataContext.RemoveScreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
