<Application x:Class="VideoWallRW.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VideoWallRW.App"
             Startup="OnStartup"
             Exit="OnExit">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Dark.xaml" />
        <ResourceDictionary Source="Themes/Auxiliary.xaml" />
        <ResourceDictionary Source="Assets/Brand.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:IdentifyLabelConverter x:Key="IdentifyLabelConverter" />
      <local:OperationLabelConverter x:Key="OperationLabelConverter" />
      <DataTemplate x:Key="OperationLabelTemplate"><TextBlock Text="{Binding Converter={StaticResource OperationLabelConverter}}" TextTrimming="CharacterEllipsis" /></DataTemplate>
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <local:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <local:EnumBoolConverter x:Key="EnumBoolConverter" />
      <local:IncrementConverter x:Key="IncrementConverter" />
      <local:InverseBoolConverter x:Key="InverseBoolConverter" />
      <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
      <local:FileNameConverter x:Key="FileNameConverter" />
      <local:ResizeModeLabelConverter x:Key="ResizeModeLabelConverter" />
      <local:ClipBaseDimensionConverter x:Key="ClipBaseDimensionConverter" />
      <local:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
