<Window x:Class="VideoWallRW.App.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renomear" Height="130" Width="360" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="OK" IsDefault="True" Click="OnOk" Padding="16,4" Margin="0,0,6,0" />
      <Button Content="Cancelar" IsCancel="True" Padding="10,4" />
    </StackPanel>
    <TextBox x:Name="Input" VerticalAlignment="Center" FontSize="13" Padding="4,3" />
  </DockPanel>
</Window>
