<Window x:Class="VideoWallRW.App.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar valor" SizeToContent="Height" MinHeight="160" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <DockPanel Background="{StaticResource Bg}" Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Aplicar" Style="{StaticResource PrimaryAction}" IsDefault="True" Click="OnOk" Padding="16,4" Margin="0,0,6,0" />
      <Button Content="Cancelar" IsCancel="True" Padding="10,4" />
    </StackPanel>
    <StackPanel>
      <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Margin="0,0,0,8" />
      <TextBox x:Name="Input" VerticalAlignment="Center" FontSize="13" Padding="4,3" AutomationProperties.Name="Novo valor" />
      <TextBlock x:Name="ErrorMessage" Foreground="{StaticResource DangerText}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
    </StackPanel>
  </DockPanel>
</Window>
