<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Marca RWVideoWall. Originais e versões tratadas em docs/assets/brand/.
       BrandMark = símbolo (R + tela) quadrado; BrandLogo = logo horizontal, fundo transparente.
       URIs absolutas (com o nome do assembly) pra funcionar também nas verificações de UI. -->
  <BitmapImage x:Key="BrandMark" UriSource="pack://application:,,,/VideoWallRW.App;component/Assets/BrandMark.png" />
  <BitmapImage x:Key="BrandLogo" UriSource="pack://application:,,,/VideoWallRW.App;component/Assets/BrandLogo.png" />
</ResourceDictionary>
