<Window x:Class="VideoWallRW.App.CanvasSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tamanho da tela" Height="230" Width="360" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" IsDefault="True" Click="OnOk" Padding="16,4" Margin="0,0,6,0" />
      <Button Content="Cancelar" IsCancel="True" Padding="10,4" />
    </StackPanel>
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="Largura" VerticalAlignment="Center" Width="56" />
        <TextBox x:Name="WidthBox" Width="70" TextChanged="OnWidthChanged" />
        <TextBlock Text="Altura" VerticalAlignment="Center" Width="50" Margin="14,0,0,0" />
        <TextBox x:Name="HeightBox" Width="70" TextChanged="OnHeightChanged" />
        <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource FgDim}" />
      </StackPanel>
      <CheckBox x:Name="KeepAspect" Content="Fixar proporção" IsChecked="True" Margin="0,0,0,10" />
      <RadioButton x:Name="ModeStretch" Content="Redimensionar imagem (esticar junto com a tela)"
                   IsChecked="True" Foreground="{StaticResource Fg}" Margin="0,0,0,4" />
      <RadioButton x:Name="ModeCanvas" Content="Redimensionar só a tela (imagem mantém o tamanho)"
                   Foreground="{StaticResource Fg}" />
    </StackPanel>
  </DockPanel>
</Window>
